<div class="top">
  <div>
    <div class="crumbs"><a href="/admin">← <%= t('nav.administrare') %></a></div>
    <h1><%= t('prestator.emailTitlu') %></h1>
    <p class="muted"><%= t('prestator.emailIntro') %></p>
  </div>
</div>

<% erori.forEach(function (e) { %><div class="warn err"><%= e %></div><% }); %>
<% ok.forEach(function (o) { %><div class="warn ok"><%= o %></div><% }); %>
<% if (proba) { %>
  <div class="warn"><b><%= t('prestator.stareProba') %></b></div>
<% } else if (pornit) { %>
  <div class="warn ok"><b><%= t('prestator.starePornit', { de: c.de }) %></b></div>
<% } else { %>
  <div class="warn err"><b><%= t('prestator.stareOprit') %></b></div>
<% } %>

<form method="post" action="/admin/email" autocomplete="off">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="panel" style="max-width:820px">
    <h2><%= t('prestator.serverTitlu') %></h2>
    <p class="legend"><%= t('prestator.serverAjutor') %></p>
    <div class="f">
      <label><%= t('prestator.host') %><input name="host" value="<%= c.host %>" placeholder="smtp.gmail.com" spellcheck="false"></label>
      <label><%= t('prestator.port') %><input name="port" type="number" min="1" max="65535" value="<%= c.host ? c.port : "" %>" placeholder="587"></label>
      <label><%= t('prestator.securitate') %><select name="secure">
        <option value="0" <%= c.secure ? '' : 'selected' %>><%= t('prestator.starttls') %></option>
        <option value="1" <%= c.secure ? 'selected' : '' %>><%= t('prestator.ssl') %></option>
      </select></label>
      <label><%= t('prestator.utilizator') %><input name="user" value="<%= c.user %>" spellcheck="false" autocomplete="off"></label>
      <label><%= t('prestator.parola') %>
        <%# ca la cheile Stripe: parola nu se arată, iar gol = rămâne cea veche %>
        <input name="parola" type="password" autocomplete="new-password" placeholder="<%= parolaMasca %>">
      </label>
      <% if (parolaMasca) { %>
        <label class="check"><input type="checkbox" name="stergeParola" value="1"> <%= t('prestator.stergeParola') %></label>
      <% } %>
      <label><%= t('prestator.de') %><input name="de" type="email" value="<%= c.host ? c.de : '' %>" placeholder="comenzi@firma.ro"></label>
      <label><%= t('prestator.numeExpeditor') %><input name="nume" value="<%= c.host ? c.nume : '' %>" placeholder="PAL Calc"></label>
    </div>
    <p class="legend"><%= t('prestator.gmailAjutor') %></p>
  </div>

  <div class="panel" style="max-width:820px">
    <h2><%= t('prestator.mesajTitlu') %></h2>
    <p class="legend"><%= t('prestator.mesajAjutor') %></p>
    <div class="f">
      <label class="full"><%= t('prestator.subiect') %>
        <input name="subiect" maxlength="200" value="<%= sab.subiect %>" placeholder="<%= sab.subiectImplicit %>">
      </label>
      <label class="full"><%= t('prestator.text') %>
        <textarea name="text" rows="10" maxlength="4000" placeholder="<%= sab.textImplicit %>"><%= sab.text %></textarea>
      </label>
    </div>
    <p class="legend"><%= t('prestator.campuri') %></p>
    <button class="btn primary" type="submit"><%= t('prestator.salveaza') %></button>
  </div>
</form>

<div class="panel" style="max-width:820px">
  <h2><%= t('prestator.probaTitlu') %></h2>
  <p class="legend"><%= t('prestator.probaAjutor', { email: user.email }) %></p>
  <form method="post" action="/admin/email/proba">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn" type="submit" <%= pornit ? '' : 'disabled' %>><%= t('prestator.probaButon') %></button>
  </form>
</div>
