<div class="top">
  <div>
    <div class="crumbs"><a href="/admin">← <%= t('nav.administrare') %></a></div>
    <h1><%= t('admin.plata.titlu') %></h1>
    <p class="muted"><%= t('admin.plata.intro') %></p>
  </div>
</div>

<% erori.forEach(function (e) { %><div class="warn err"><%= e %></div><% }); %>
<% ok.forEach(function (o) { %><div class="warn ok"><%= o %></div><% }); %>
<% if (contStripe) { %><div class="warn ok"><%= t('admin.plata.contStripe', { nume: contStripe }) %></div><% } %>

<%# Starea de acum, pe primul rand si cu culoare: e singurul lucru de pe
    pagina pe care trebuie sa-l stii fara sa citesti restul. %>
<% if (stare.driver === 'fake') { %>
  <div class="warn err"><b><%= t('admin.plata.stareFake') %></b></div>
<% } else if (!stare.pornita) { %>
  <div class="warn err"><b><%= t('admin.plata.stareOprita') %></b></div>
<% } else if (stare.mod === 'test') { %>
  <div class="warn"><b><%= t('admin.plata.stareTest') %></b></div>
<% } else { %>
  <div class="warn ok"><b><%= t('admin.plata.stareLive') %></b></div>
<% } %>

<% if (necitite) { %><div class="warn err"><%= t('admin.plata.eroareNecitite') %></div><% } %>

<div class="panel" style="max-width:820px">
  <form method="post" action="/admin/plata" autocomplete="off">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <fieldset>
      <legend><%= t('admin.plata.felul') %></legend>
      <p><label><input type="radio" name="driver" value="fake" <%= stare.driver !== 'stripe' ? 'checked' : '' %>>
        <%= t('admin.plata.driverFake') %></label></p>
      <p><label><input type="radio" name="driver" value="stripe" <%= stare.driver === 'stripe' ? 'checked' : '' %>>
        <%= t('admin.plata.driverStripe') %></label></p>
      <p class="legend"><%= t('admin.plata.felulNota') %></p>
    </fieldset>

    <fieldset>
      <legend><%= t('admin.plata.chei') %></legend>
      <div class="f">
        <label class="full"><%= t('admin.plata.cheieSecreta') %>
          <%# type=password: cheia nu ramane pe ecran cat timp omul o lipeste,
              si browserul nu o propune altora din istoric. %>
          <input type="password" name="cheie" spellcheck="false" autocomplete="off"
                 placeholder="<%= cheie.masca || 'sk_live_…' %>">
        </label>
      </div>
      <p class="legend">
        <%= t('admin.plata.cheieSecretaAjutor') %>
        <%= cheie.masca ? t('admin.plata.acum', { cheie: cheie.masca }) : t('admin.plata.lipsa') %>
        <% if (cheie.sursa === 'env') { %><%= t('admin.plata.dinFisier') %><% } %>
      </p>

      <div class="f">
        <label class="full"><%= t('admin.plata.cheieWebhook') %>
          <input type="password" name="whsec" spellcheck="false" autocomplete="off"
                 placeholder="<%= webhook.masca || 'whsec_…' %>">
        </label>
      </div>
      <p class="legend">
        <%= t('admin.plata.cheieWebhookAjutor') %>
        <%= webhook.masca ? t('admin.plata.acum', { cheie: webhook.masca }) : t('admin.plata.lipsa') %>
        <% if (webhook.sursa === 'env') { %><%= t('admin.plata.dinFisier') %><% } %>
      </p>

      <% if (adresaWebhook) { %>
        <p class="legend"><%= t('admin.plata.adresaWebhook') %> <code><%= adresaWebhook %></code></p>
      <% } else { %>
        <div class="warn"><%= t('admin.plata.faraAdresa') %></div>
      <% } %>
      <p class="legend"><%= t('admin.plata.golPastreaza') %></p>
    </fieldset>

    <div class="btns">
      <button class="btn primary" type="submit"><%= t('admin.plata.salveaza') %></button>
      <% if (cheie.sursa === 'aplicatie' || webhook.sursa === 'aplicatie') { %>
        <button class="btn danger" type="submit" name="sterge" value="1"
                data-confirma="<%= t('admin.plata.stergeIntrebare') %>"
                data-confirma-buton="<%= t('admin.plata.sterge') %>"><%= t('admin.plata.sterge') %></button>
      <% } %>
    </div>
  </form>
</div>
