<%# Sus: „filmul". Un corp din catalog se desface piesă cu piesă, iar
    lista de debitare, planșa CNC și fișa de montaj se aprind pe rând.
    Datele le calculează serverul (src/film.js); public/film.js desenează. %>
<section class="film" id="film">
  <div class="film-text">
    <div class="film-eticheta"><%= t('landing.film.eticheta') %></div>
    <h1 class="film-titlu"><%= t('landing.film.titluA') %> <em><%= t('landing.film.titluB') %></em></h1>
    <ol class="film-pasi">
      <% [1, 2, 3, 4].forEach(function (n) { %>
        <li<%- n === 1 ? ' class="on"' : '' %>>
          <button type="button">
            <span class="film-nr"><%= n %></span>
            <span><b><%= t('landing.film.pas' + n + 'T') %></b><span><%= t('landing.film.pas' + n + 'S') %></span></span>
          </button>
        </li>
      <% }); %>
    </ol>
    <div class="film-cta">
      <a class="btn primary mare" href="/register"><%= t('landing.faCont') %></a>
      <a class="btn mare" href="/login"><%= t('landing.amCont') %></a>
      <span class="film-pret"><%- t('landing.film.pret', { pret: '<b>' + String(pretPublic).replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</b>' }) %></span>
    </div>
  </div>

  <div class="film-scena">
    <div class="film-ecran">
      <div class="film-antet"><b class="film-nume"></b><span class="film-cote"></span></div>
      <svg class="film-svg" viewBox="0 0 520 470" role="img" aria-label="<%= t('landing.film.desen') %>"></svg>
      <div class="film-progres"><span></span></div>
    </div>
    <div class="film-carduri">
      <div class="film-card">
        <div class="film-card-t"><%= t('landing.film.cardDebitare') %></div>
        <ul class="film-debitare"></ul>
      </div>
      <div class="film-card">
        <div class="film-card-t"><%= t('landing.film.cardCnc') %> · <span class="film-cnc-piesa"></span></div>
        <div class="film-cnc"></div>
        <div class="film-cnc-nota small muted"></div>
      </div>
      <div class="film-card">
        <div class="film-card-t"><%= t('landing.film.cardMontaj') %></div>
        <ol class="film-montaj"></ol>
      </div>
    </div>
  </div>
</section>
<script type="application/json" id="film-date"><%- jsonPentruPagina(film) %></script>
<script src="/static/film.js?v=<%= assetV %>" defer></script>

<section class="panel zona-chemare">
  <div>
    <b><%= t('planificator.landingTitlu') %></b>
    <p class="muted small"><%= t('planificator.landingSub') %></p>
  </div>
  <div class="btns"><a class="btn primary" href="/planificator"><%= t('planificator.landingButon') %></a></div>
</section>

<%# Exemplul nu e scris de mână: se calculează la fiecare deschidere a
    paginii, cu motorul care scoate și lucrările din atelier. Dacă se schimbă
    regula de debitare, se schimbă și cifrele de-aici — n-are cum să rămână
    în urmă. Și vine gata tradus: numele pieselor sunt chei din catalog. %>
<section class="panel">
  <h2><%= t('landing.exempluTitlu') %></h2>
  <p class="muted"><%= t('landing.exempluSub', {
    W: exemplu.W, H: exemplu.H, D: exemplu.D,
    pal: exemplu.t, gros: exemplu.cg, subtire: exemplu.cs
  }) %></p>

  <div class="tbl"><table>
    <thead><tr>
      <th><%= t('editor.colPiesa') %></th>
      <th class="num"><%= t('editor.colBuc') %></th>
      <th class="num"><%= t('editor.colFinitL') %></th>
      <th class="num"><%= t('editor.colFinitl') %></th>
      <th><%= t('editor.colCantMuchii') %></th>
      <th class="num"><%= t('editor.colTaiereL') %></th>
      <th class="num"><%= t('editor.colTaierel') %></th>
    </tr></thead>
    <tbody>
      <% piese.forEach(function (p) { %>
        <tr>
          <td><%= p.nume %></td>
          <td class="num"><%= p.buc %></td>
          <td class="num"><%= p.L %></td>
          <td class="num"><%= p.l %></td>
          <td><span class="cant">
            <% p.c.forEach(function (m) { %>
              <span class="<%= m === 'g' ? 'g' : m === 's' ? 's' : '' %>"><%=
                m === 'g' ? exemplu.cg : m === 's' ? exemplu.cs : '–' %></span>
            <% }); %>
          </span></td>
          <td class="num"><b><%= p.TL %></b></td>
          <td class="num"><b><%= p.Tl %></b></td>
        </tr>
      <% }); %>
    </tbody>
  </table></div>
  <p class="legend"><%= t('editor.legendaCant') %></p>
</section>

<section class="panel">
  <h2><%= t('landing.hartiiTitlu') %></h2>
  <p class="muted"><%= t('landing.hartiiSub') %></p>
  <ul class="ticks cols2">
    <li><b><%= t('print.linkDebitare') %></b></li>
    <li><b><%= t('print.linkIncadrare') %></b></li>
    <li><b><%= t('print.linkCorpuri') %></b></li>
    <li><b><%= t('print.linkAnsamblu') %></b></li>
    <li><b><%= t('print.linkMontaj') %></b></li>
    <li><b><%= t('print.linkCnc') %></b></li>
  </ul>
</section>

<section class="cards3">
  <div class="panel">
    <h2><%= t('landing.gratuit') %></h2>
    <ul class="ticks">
      <li><%= t('landing.gratuit1') %></li>
      <li><%= t('landing.gratuit2') %></li>
      <li><%= t('landing.gratuit3') %></li>
      <li><%= t('landing.gratuit4') %></li>
    </ul>
  </div>
  <div class="panel">
    <h2><%= t('landing.platitPublic', { pret: pretPublic }) %></h2>
    <ul class="ticks">
      <li><%= t('landing.platit1') %></li>
      <li><%= t('landing.platit2') %></li>
      <li><%= t('landing.platit3') %></li>
      <li><%= t('landing.platit4') %></li>
    </ul>
  </div>
  <div class="panel">
    <h2><%= t('landing.cum') %></h2>
    <ol class="steps">
      <li><%= t('landing.cum1') %></li>
      <li><%= t('landing.cum2') %></li>
      <li><%= t('landing.cum3') %></li>
      <li><%= t('landing.cum4') %></li>
    </ol>
  </div>
</section>

<%# Numele limbilor se scriu în ele însele, nu traduse: un om care nu citește
    româna trebuie să-și găsească limba pe listă. %>
<section class="panel">
  <h2><%= t('landing.limbiTitlu') %></h2>
  <p class="muted"><%= t('landing.limbiSub') %></p>
  <p class="limbi-lista">
    <% limbi.forEach(function (l, i) { %><%= i ? ' · ' : '' %><span lang="<%= l.cod %>"><%= l.nume %></span><% }); %>
  </p>
</section>

<section class="panel zona-chemare">
  <div>
    <b><%= t('articole.titlu') %></b>
    <p class="muted small"><%= t('articole.intro') %></p>
  </div>
  <div class="btns">
    <a class="btn" href="/ghid"><%= t('articole.citeste') %></a>
    <a class="btn primary" href="/register"><%= t('landing.faCont') %></a>
  </div>
</section>
