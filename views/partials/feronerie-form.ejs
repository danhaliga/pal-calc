<%
/* Întrebările de feronerie. Se pun la deschiderea comenzii, înainte de corpuri:
   de răspunsuri depind și cantitățile din listă, și cotele de găurire.
   Parametri: f = opțiunile (PalFeronerie.optiuni()), ales = alegerile curente. */
%>
<fieldset>
  <legend>Feronerie</legend>
  <p class="hint">
    Alege acum sistemul, înainte de corpuri: din el ies cantitățile din lista de feronerie
    și cotele din programul de găurire al fiecărei piese.
  </p>

  <div class="alegeri">
    <p class="alegeri-titlu">Cum se asamblează carcasa?</p>
    <% f.asamblare.forEach(function (o) { %>
      <label class="card-radio">
        <input type="radio" name="asamblare" value="<%= o.id %>"
               <%= ales.asamblare === o.id ? 'checked' : '' %>>
        <span>
          <b><%= o.nume %></b>
          <small><%= o.descriere %></small>
        </span>
      </label>
    <% }); %>
  </div>

  <div class="alegeri">
    <p class="alegeri-titlu">Ce balamale pui la uși?</p>
    <% f.balama.forEach(function (o) { %>
      <label class="card-radio">
        <input type="radio" name="balama" value="<%= o.id %>"
               <%= ales.balama === o.id ? 'checked' : '' %>>
        <span>
          <b><%= o.nume %></b>
          <small><%= o.descriere %></small>
        </span>
      </label>
    <% }); %>
  </div>

  <div class="alegeri">
    <p class="alegeri-titlu">Ce glisiere pui la sertare?</p>
    <% f.glisiere.forEach(function (o) { %>
      <label class="card-radio">
        <input type="radio" name="glisiere" value="<%= o.id %>"
               <%= ales.glisiere === o.id ? 'checked' : '' %>>
        <span>
          <b><%= o.nume %></b>
          <small><%= o.descriere %><% if (o.jocPeParte != null) { %> Joc <%= o.jocPeParte %> mm pe parte.<% } %></small>
        </span>
      </label>
    <% }); %>
  </div>

  <div class="alegeri">
    <p class="alegeri-titlu">Corpurile suspendate se prind cu suspensii?</p>
    <label class="card-radio">
      <input type="checkbox" name="suspensii" value="on" <%= ales.suspensii ? 'checked' : '' %>>
      <span>
        <b><%= f.suspensii.nume %></b>
        <small>
          <%= f.suspensii.descriere %>
          Câte <%= f.suspensii.peCorp %> pe corp, <%= f.suspensii.portantaPePereche %> kg pe pereche.
          Fără ele, corpurile se prind cu coltare vizibile.
        </small>
      </span>
    </label>
  </div>
</fieldset>
