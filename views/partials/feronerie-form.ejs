<%
/* Întrebările de feronerie. Se pun la deschiderea comenzii, înainte de corpuri:
   de răspunsuri depind și cantitățile din listă, și cotele de găurire.
   Parametri: f = opțiunile (PalFeronerie.optiuni(t)), ales = alegerile curente. */
%>
<fieldset>
  <legend><%= t('fero.legenda') %></legend>
  <p class="hint"><%= t('fero.intro') %></p>

  <% [['asamblare', 'fero.intrebareAsamblare'],
      ['balama',    'fero.intrebareBalama'],
      ['glisiere',  'fero.intrebareGlisiere'],
      ['plinta',    'fero.intrebarePlinta'],
      ['maner',     'fero.intrebareManer']].forEach(function (grup) { %>
    <div class="alegeri">
      <p class="alegeri-titlu"><%= t(grup[1]) %></p>
      <% f[grup[0]].forEach(function (o) { %>
        <label class="card-radio">
          <input type="radio" name="<%= grup[0] %>" value="<%= o.id %>"
                 <%= ales[grup[0]] === o.id ? 'checked' : '' %>>
          <span>
            <b><%= o.nume %></b>
            <small><%= o.descriere %><% if (o.jocPeParte != null) { %>
              <%= t('fero.jocPeParte', { mm: o.jocPeParte }) %><% } %></small>
          </span>
        </label>
      <% }); %>
    </div>
  <% }); %>

  <div class="alegeri">
    <p class="alegeri-titlu"><%= t('fero.intrebareSuspensii') %></p>
    <label class="card-radio">
      <input type="checkbox" name="suspensii" value="on" <%= ales.suspensii ? 'checked' : '' %>>
      <span>
        <b><%= f.suspensii.nume %></b>
        <small>
          <%= f.suspensii.descriere %>
          <%= t('fero.suspensiiDetalii', { n: f.suspensii.peCorp, kg: f.suspensii.portantaPePereche }) %>
        </small>
      </span>
    </label>
  </div>
</fieldset>
