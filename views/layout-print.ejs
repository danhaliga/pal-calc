<!doctype html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="/static/styles.css?v=<%= assetV %>">
<link rel="stylesheet" href="/static/print.css?v=<%= assetV %>">
<script src="/shared/i18n.js?v=<%= assetV %>"></script>
<script src="/static/i18n-pagina.js?v=<%= assetV %>"></script>
</head>
<body class="doc">

<div class="doc-bar no-print">
  <a href="/orders/<%= order.id %>">← <%= t('print.inapoiLaComanda') %></a>
  <span class="doc-links">
    <a href="/orders/<%= order.id %>/print/ansamblu"><%= t('print.linkAnsamblu') %></a>
    <a href="/orders/<%= order.id %>/print/corpuri"><%= t('print.linkCorpuri') %></a>
    <a href="/orders/<%= order.id %>/print/debitare"><%= t('print.linkDebitare') %></a>
    <a href="/orders/<%= order.id %>/print/incadrare"><%= t('print.linkIncadrare') %></a>
    <a href="/orders/<%= order.id %>/print/montaj"><%= t('print.linkMontaj') %></a>
    <a href="/orders/<%= order.id %>/print/cnc"><%= t('print.linkCnc') %></a>
    <a href="/orders/<%= order.id %>/export.csv">CSV</a>
  </span>
  <%- include('partials/limba') %>
  <button data-tipareste class="btn small primary"><%= t('comun.tipareste') %></button>
</div>

<header class="doc-head">
  <div>
    <h1><%= titlu %></h1>
    <div class="doc-sub">
      <b><%= order.name %></b>
      <% materiale.forEach(function (m) { %>
        · <%= m.nume %>
        <span class="muted"><%= t('print.materialDetalii', {
          brand: m.brand,
          decor: [m.decor_cod, m.decor_nume].filter(Boolean).join(' '),
          pal: m.pal_mm, gros: m.cant_gros, subtire: m.cant_subtire }) %></span>
      <% }); %>
    </div>
  </div>
  <div class="doc-meta">
    <%# Atelierul, sus pe foaie. Foaia asta pleaca la cel care taie palul:
        acolo trebuie sa scrie al cui e corpul si pe ce numar se suna daca o
        cota nu se potriveste. Pana acum nu scria nimic. %>
    <% if (capFoaie) { %>
      <div class="doc-atelier">
        <b><%= capFoaie.nume %></b>
        <% if (capFoaie.oras) { %> · <%= capFoaie.oras %><% } %>
        <% if (capFoaie.telefon) { %> · <%= capFoaie.telefon %><% } %>
        <% if (capFoaie.cui) { %><br><span class="muted"><%= capFoaie.cui %></span><% } %>
      </div>
    <% } %>
    <div><%= t('print.comandaNr', { id: order.id }) %></div>
    <div><%= order.created_at.slice(0, 10) %></div>
    <%# Livrarea si telefonul intra pe fiecare foaie care pleaca in atelier:
        acolo se uita omul dupa ele, nu in aplicatie. %>
    <% if (order.livrare_la) { %>
      <div><b><%= t('comanda.livrareLa') %>: <%= order.livrare_la %></b></div>
    <% } %>
    <% if (order.telefon) { %>
      <div><%= t('comanda.telefon') %>: <%= order.telefon %></div>
    <% } %>
    <div class="muted"><%= t('print.tiparitLa', { data: new Date().toLocaleDateString(lang) }) %></div>
  </div>
</header>

<main class="doc-body">
<%- body %>
</main>

<footer class="doc-foot">
  <%- t('print.subsol') %>
</footer>

<script src="/static/interactiuni.js?v=<%= assetV %>"></script>
</body>
</html>
