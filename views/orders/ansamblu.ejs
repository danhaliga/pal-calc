<div class="top">
  <div>
    <div class="crumbs"><a href="/orders/<%= order.id %>">← <%= order.name %></a></div>
    <h1><%= t('ansamblu.titlu') %></h1>
    <div class="muted small">
      <%= t('ansamblu.antet', { A: ansamblu.camera.A, B: ansamblu.camera.B, H: ansamblu.camera.H }) %> ·
      <%= t('ansamblu.nrAsezate', { n: ansamblu.asezari.length }) %>
    </div>
  </div>
  <div class="btns" style="margin:0">
    <form method="post" action="/orders/<%= order.id %>/aseaza" class="inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="inaltime_sus" value="1400">
      <button class="btn primary" type="submit" title="<%= t('ansamblu.asazaTitlu') %>">
        <%= t('ansamblu.asazaAutomat') %>
      </button>
    </form>
    <a class="btn" href="/orders/<%= order.id %>/print/ansamblu"><%= t('ansamblu.planseDeTiparit') %></a>
  </div>
</div>

<!-- ---------------- planificatorul 3D ---------------- -->
<%# Corpurile se mută cu mâna: tragi de un corp și se așază pe peretele cel
    mai apropiat, lipit de vecini. Poziția se salvează singură (public/ansamblu.js). %>
<div class="panel planificator">
  <div class="top" style="margin-bottom:8px">
    <h2 style="margin:0"><%= t('ansamblu.in3d') %></h2>
    <div class="btns" style="margin:0">
      <button class="btn small" data-vedere="iso"><%= t('ansamblu.vedereIzo') %></button>
      <button class="btn small" data-vedere="fata"><%= t('ansamblu.vedereFata') %></button>
      <button class="btn small" data-vedere="sus"><%= t('ansamblu.vedereSus') %></button>
      <label class="check" style="margin-left:8px"><input type="checkbox" id="anPereti" checked> <%= t('ansamblu.aratPereti') %></label>
    </div>
  </div>
  <div class="cvwrap" id="anWrap"><canvas id="anCanvas"></canvas><div class="an-stare" id="anStare" hidden></div></div>
  <div class="info an-panou" id="anInfo"></div>
</div>

<div id="anProbleme">
<% if (ansamblu.probleme.length) { %>
  <div class="warn err">
    <b><%= t('ansamblu.deReglat') %></b>
    <% ansamblu.probleme.forEach(function (p) { %><div><%= p.text %></div><% }); %>
  </div>
<% } %>

</div>

<div id="anSus">
<div class="ansamblu-sus">
  <div class="panel">
    <h2><%= t('ansamblu.camerariDeSus') %></h2>
    <div class="an-plan"><%- ansamblu.plan %></div>
    <p class="legend"><%= t('ansamblu.legendaPlan') %></p>
  </div>

  <div class="panel">
    <h2><%= t('ansamblu.camera') %></h2>
    <form method="post" action="/orders/<%= order.id %>/camera">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="f">
        <label><%= t('ansamblu.laturaA') %><input type="number" name="A" min="500" max="20000" step="10"
               value="<%= ansamblu.camera.A %>"></label>
        <label><%= t('ansamblu.laturaB') %><input type="number" name="B" min="500" max="20000" step="10"
               value="<%= ansamblu.camera.B %>"></label>
        <label><%= t('ansamblu.inaltime') %><input type="number" name="H" min="1500" max="5000" step="10"
               value="<%= ansamblu.camera.H %>"></label>
      </div>
      <button class="btn primary" type="submit" style="margin-top:10px"><%= t('ansamblu.salveazaCamera') %></button>
    </form>

    <h2 style="margin-top:18px"><%= t('ansamblu.ocuparePereti') %></h2>
    <div class="tbl"><table>
      <thead><tr><th><%= t('ansamblu.colPerete') %></th><th class="num"><%= t('ansamblu.colLungime') %></th>
        <th class="num"><%= t('ansamblu.colJos') %></th><th class="num"><%= t('ansamblu.colSus') %></th></tr></thead>
      <tbody>
        <% ansamblu.pereti.forEach(function (p) { %>
          <tr>
            <td><b><%= p.id %></b> <span class="muted small"><%= p.nume %></span></td>
            <td class="num"><%= p.lungime %></td>
            <td class="num <%= p.ocupatJos > p.lungime ? 'peste' : '' %>"><%= p.ocupatJos %></td>
            <td class="num <%= p.ocupatSus > p.lungime ? 'peste' : '' %>"><%= p.ocupatSus %></td>
          </tr>
        <% }); %>
      </tbody>
    </table></div>

    <% if (ansamblu.goluri.length) { %>
      <h2 style="margin-top:16px"><%= t('ansamblu.goluri') %></h2>
      <ul class="ticks">
        <% ansamblu.goluri.forEach(function (g) { %>
          <li><%- t('ansamblu.gol', { perete: g.perete, sus: g.h > 0 ? t('ansamblu.golSus') : '',
                                      lung: g.lung, de_la: g.de_la, pana_la: g.pana_la }) %></li>
        <% }); %>
      </ul>
    <% } %>
  </div>
</div>

</div>

<div id="anElevatii">
<!-- ---------------- elevațiile ---------------- -->
<% pereti.forEach(function (per) {
     var p = ansamblu.pereti.find(function (x) { return x.id === per.id; });
     if (!p || !p.corpuri.length) return; %>
  <div class="panel">
    <h2><%= t('ansamblu.peretele', { id: per.id, nume: per.nume.toLowerCase(), lungime: p.lungime }) %></h2>
    <div class="an-elev"><%- elevatie(ansamblu.asezari, ansamblu.camera, per.id) %></div>
  </div>
<% }); %>

</div>

<div id="anPozitii">
<!-- ---------------- poziția fiecărui corp ---------------- -->
<div class="panel">
  <h2><%= t('ansamblu.pozitiaCorpurilor') %></h2>
  <p class="hint"><%= t('ansamblu.notaPozitie') %></p>
  <div class="tbl"><table>
    <thead><tr>
      <th class="num">#</th><th><%= t('ansamblu.colCorp') %></th>
      <th class="num"><%= t('ansamblu.colLatime') %></th><th class="num"><%= t('ansamblu.colAdancime') %></th>
      <th><%= t('ansamblu.colPerete') %></th><th class="num"><%= t('ansamblu.colDistanta') %></th>
      <th class="num"><%= t('ansamblu.colInaltime') %></th><th></th>
    </tr></thead>
    <tbody>
      <% ansamblu.asezari.forEach(function (a) { %>
        <tr>
          <td class="num"><%= a.nr %></td>
          <td><a href="/corps/<%= a.id %>"><%= a.nume %></a></td>
          <td class="num"><%= a.W %></td>
          <td class="num"><%= a.D %></td>
          <td colspan="4">
            <form method="post" action="/corps/<%= a.id %>/pozitie" class="mat-inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <select name="perete" aria-label="<%= t('ansamblu.colPerete') %>">
                <% pereti.forEach(function (per) { %>
                  <option value="<%= per.id %>" <%= a.perete.id === per.id ? 'selected' : '' %>>
                    <%= per.id %> — <%= per.nume.toLowerCase() %>
                  </option>
                <% }); %>
              </select>
              <input type="number" name="d" value="<%= a.poz.d %>" step="10" min="0" style="width:96px"
                     aria-label="<%= t('ansamblu.colDistanta') %>">
              <input type="number" name="h" value="<%= a.poz.h %>" step="10" min="0" style="width:96px"
                     aria-label="<%= t('ansamblu.colInaltime') %>">
              <button class="btn small" type="submit"><%= t('ansamblu.pune') %></button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table></div>
</div>

</div>

<script type="application/json" id="page-data"><%- jsonPentruPagina({
  orderId: order.id,
  t: ['indiciu', 'selectat', 'perete', 'deLaColt', 'inaltime', 'deschide', 'salvat', 'seSalveaza',
      'eroare', 'seSuprapune', 'stanga', 'dreapta', 'seIncarca', 'nuSeIncarca', 'nu3d', 'renunta']
     .reduce(function (o, k) { o[k] = t('ansamblu.p3d.' + k); return o; }, {}),
  pereti: pereti.map(function (p) { return { id: p.id, nume: p.nume }; })
}) %></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="/static/ansamblu.js?v=<%= assetV %>"></script>
