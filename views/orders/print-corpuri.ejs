<table class="doc-tbl">
  <thead><tr>
    <th class="num">#</th>
    <th><%= t('print.colDenumireCorp') %></th>
    <th><%= t('print.colDimensiuniLHA') %></th>
    <th><%= t('print.colContine') %></th>
    <th><%= t('print.colMaterial') %></th>
    <th class="num"><%= t('print.colPiese') %></th>
    <th><%= t('print.colObservatii') %></th>
  </tr></thead>
  <tbody>
    <% raport.corpuri.forEach(function (c) { %>
      <tr>
        <td class="num"><%= c.poz %></td>
        <td><b><%= c.nume %></b></td>
        <td class="num"><%= c.dimensiuni %></td>
        <td>
          <%# „fara fronturi" sta in acelasi rand ca pe card si in aceeasi
              ordine: cine se uita in doua locuri la acelasi corp trebuie sa
              citeasca acelasi lucru. %>
          <% if (c.params.tip === 'piesa') { %>
            <%= (c.params.pieseExtra || []).length ? t('print.piese') + ': ' + (1 + c.params.pieseExtra.length) : t('rezumat.piesa') %>
          <% } else { %>
          <%= [+c.params.nUsi ? t('corpuri.metaUsi', { n: +c.params.nUsi }) : null,
               +c.params.nSer ? t('corpuri.metaSertare', { n: +c.params.nSer }) : null,
               +c.params.nPol ? t('corpuri.metaPolite', { n: +c.params.nPol }) : null,
               +c.params.faraFront ? t('rezumat.faraFront') : null,
               c.params.spate === 'aplicat' ? t('print.spateAplicat') : t('print.spateNut')
              ].filter(Boolean).join(', ') %>
          <% } %>
        </td>
        <td class="small">
          <%= c.materialCorp ? c.materialCorp.nume : '—' %>
          <% if (c.materialFront && c.materialCorp && c.materialFront.id !== c.materialCorp.id) { %>
            <div class="tag"><%= t('print.fronturiDin', { nume: c.materialFront.nume }) %></div>
          <% } %>
        </td>
        <td class="num"><%= c.bucati %></td>
        <td class="small"><%= c.avertismente.join(' ') %></td>
      </tr>
    <% }); %>
  </tbody>
  <tfoot>
    <tr>
      <td></td><td colspan="4"><b><%= t('comun.total') %></b></td>
      <td class="num"><b><%= raport.totaluri.bucati %></b></td>
      <td></td>
    </tr>
  </tfoot>
</table>

<section class="doc-sect">
  <h2><%= t('print.materialeleComenzii') %></h2>
  <table class="doc-tbl">
    <thead><tr>
      <th><%= t('print.colNume') %></th><th><%= t('print.colRol') %></th>
      <th><%= t('print.colProducator') %></th><th><%= t('print.colDecor') %></th>
      <th class="num"><%= t('print.colPal') %></th>
      <th class="num"><%= t('print.colCantGros') %></th>
      <th class="num"><%= t('print.colCantSubtire') %></th>
    </tr></thead>
    <tbody>
      <% materiale.forEach(function (m) { %>
        <tr>
          <td><b><%= m.nume %></b></td>
          <td class="small"><%= t('rol.' + m.rol) %></td>
          <td><%= m.brand %></td>
          <td><%= [m.decor_cod, m.decor_nume].filter(Boolean).join(' ') || '—' %></td>
          <td class="num"><%= m.pal_mm %> mm</td>
          <td class="num"><%= m.cant_gros %> mm</td>
          <td class="num"><%= m.cant_subtire %> mm</td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</section>

<section class="doc-sect">
  <h2><%= t('print.necesarPlaci') %></h2>
  <table class="doc-tbl">
    <thead><tr>
      <th><%= t('print.colMaterial') %></th><th class="num"><%= t('print.colPiese') %></th>
      <th class="num"><%= t('print.colM2') %></th>
      <th><%= t('print.colColiFolosite') %></th><th class="num"><%= t('print.colEchivalent') %></th>
      <th class="num"><%= t('print.colDeCumparat') %></th><th class="num"><%= t('print.colDeseu') %></th>
    </tr></thead>
    <tbody>
      <% raport.materiale.forEach(function (m) { %>
        <tr>
          <td><b><%= m.nume %></b></td>
          <td class="num"><%= m.bucati %></td>
          <td class="num"><%= m.m2piese %></td>
          <td class="small"><%= m.bucatiColi.map(function (b) { return b.n + ' × ' + b.format.nume; }).join(' + ') %></td>
          <td class="num"><%= m.echivalent %></td>
          <td class="num"><b><%= t('comanda.nColi', { n: m.coliIntregi }) %></b></td>
          <td class="num"><%= m.deseuPct %>%</td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <h2><%= t('comanda.cant') %></h2>
  <table class="doc-tbl">
    <thead><tr>
      <th><%= t('print.colGrosime') %></th><th><%= t('print.colDecor') %></th>
      <th class="num"><%= t('print.colMetriLiniari') %></th>
      <% if (aratAdaos) { %>
        <th class="num"><%= t('print.colCuAdaos', { pct: raport.cant.adaosPct }) %></th>
        <th class="num"><%= t('print.colRole') %></th>
      <% } %>
    </tr></thead>
    <tbody>
      <% raport.cant.linii.forEach(function (c) { %>
        <tr>
          <td><b><%= c.mm %> mm</b></td>
          <td><%= c.decor %></td>
          <td class="num"><b><%= c.ml %> <%= t('comun.ml') %></b></td>
          <% if (aratAdaos) { %>
            <td class="num"><%= c.cuAdaos %> <%= t('comun.ml') %></td><td class="num"><%= c.role %></td>
          <% } %>
        </tr>
      <% }); %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="2"><b><%= t('comun.total') %></b></td>
        <td class="num"><b><%= raport.cant.total %> <%= t('comun.ml') %></b></td>
        <% if (aratAdaos) { %>
          <td class="num"><%= raport.cant.totalCuAdaos %> <%= t('comun.ml') %></td><td></td>
        <% } %>
      </tr>
    </tfoot>
  </table>

  <p class="doc-nota">
    <%= t('print.notaPlaci') %>
    <% if (aratAdaos) { %>
      <%= t('print.notaAdaos', { pct: raport.cant.adaosPct }) %>
    <% } %>
  </p>
</section>
