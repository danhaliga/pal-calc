<p class="doc-nota">
  <%- t('print.notaAnsamblu', { A: ansamblu.camera.A, B: ansamblu.camera.B, H: ansamblu.camera.H }) %>
</p>

<% if (ansamblu.probleme.length) { %>
  <div class="doc-warn">
    <% ansamblu.probleme.forEach(function (p) { %><div>⚠ <%= p.text %></div><% }); %>
  </div>
<% } %>

<section class="doc-sect">
  <h2><%= t('print.planDeSus') %></h2>
  <div class="an-plan-print"><%- ansamblu.plan %></div>
</section>

<% pereti.forEach(function (per) {
     var p = ansamblu.pereti.find(function (x) { return x.id === per.id; });
     if (!p || !p.corpuri.length) return; %>
  <section class="doc-sect">
    <h2><%= t('print.peretele', { id: per.id, nume: per.nume.toLowerCase(), lungime: p.lungime }) %></h2>
    <div class="an-elev-print"><%- elevatie(ansamblu.asezari, ansamblu.camera, per.id) %></div>
    <table class="doc-tbl mic">
      <thead><tr>
        <th class="num">#</th><th><%= t('print.colCorp') %></th>
        <th class="num"><%= t('print.colLatime') %></th><th class="num"><%= t('print.colInaltime') %></th>
        <th class="num"><%= t('print.colAdancime') %></th>
        <th class="num"><%= t('print.colDeLaColt') %></th><th class="num"><%= t('print.colDeLaPodea') %></th>
      </tr></thead>
      <tbody>
        <% p.corpuri.slice().sort(function (a, b) { return a.poz.h - b.poz.h || a.poz.d - b.poz.d; })
             .forEach(function (a) { %>
          <tr>
            <td class="num"><%= a.nr %></td>
            <td><%= a.nume %></td>
            <td class="num"><%= a.W %></td>
            <td class="num"><%= a.H %></td>
            <td class="num"><%= a.D %></td>
            <td class="num"><b><%= a.poz.d %></b></td>
            <td class="num"><b><%= a.poz.h %></b></td>
          </tr>
        <% }); %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="2"><b><%= t('print.ocupat') %></b></td>
          <td class="num"><%- t('print.ocupatJos', { n: p.ocupatJos }) %></td>
          <td colspan="2"><%- t('print.ocupatSus', { n: p.ocupatSus }) %></td>
          <td colspan="2"><%= t('print.dinLungime', { n: p.lungime }) %></td>
        </tr>
      </tfoot>
    </table>
  </section>
<% }); %>

<% if (ansamblu.goluri.length) { %>
  <section class="doc-sect">
    <h2><%= t('print.goluri') %></h2>
    <table class="doc-tbl mic">
      <thead><tr><th><%= t('ansamblu.colPerete') %></th><th><%= t('print.colNivel') %></th>
        <th class="num"><%= t('print.colDeLa') %></th><th class="num"><%= t('print.colPanaLa') %></th>
        <th class="num"><%= t('print.colLungime') %></th></tr></thead>
      <tbody>
        <% ansamblu.goluri.forEach(function (g) { %>
          <tr>
            <td><%= g.perete %></td>
            <td><%= g.h > 0 ? t('print.nivelSus', { mm: g.h }) : t('print.nivelJos') %></td>
            <td class="num"><%= g.de_la %></td>
            <td class="num"><%= g.pana_la %></td>
            <td class="num"><b><%= g.lung %> mm</b></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <p class="doc-nota"><%= t('print.notaGoluri') %></p>
  </section>
<% } %>
