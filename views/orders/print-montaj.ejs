<p class="doc-nota"><%= t('print.notaMontaj') %></p>

<section class="doc-sect">
  <h2><%= t('fero.sistemComenzii') %></h2>
  <table class="doc-tbl">
    <tbody>
      <tr><th><%= t('fero.randCarcasa') %></th><td><%= raport.sistemFeronerie.asamblare.nume %></td>
          <td class="small"><%= raport.sistemFeronerie.asamblare.descriere %></td></tr>
      <tr><th><%= t('fero.randBalamale') %></th><td><%= raport.sistemFeronerie.balama.nume %></td>
          <td class="small"><%= raport.sistemFeronerie.balama.descriere %></td></tr>
      <tr><th><%= t('fero.randGlisiere') %></th><td><%= raport.sistemFeronerie.glisiere.nume %></td>
          <td class="small"><%= raport.sistemFeronerie.glisiere.descriere %></td></tr>
      <tr><th><%= t('fero.randPerete') %></th>
          <td><%= raport.sistemFeronerie.suspensii ? raport.sistemFeronerie.suspensii.nume : t('fero.coltareAparente') %></td>
          <td class="small"><% if (raport.sistemFeronerie.suspensii) { %><%= t('fero.suspensiiRezumat', {
                n: raport.sistemFeronerie.suspensii.peCorp,
                kg: raport.sistemFeronerie.suspensii.portantaPePereche }) %><% } else { %><%= t('fero.faraSuspensii') %><% } %></td></tr>
    </tbody>
  </table>
</section>

<% raport.corpuri.forEach(function (c) { %>
  <section class="doc-corp">
    <h2><span class="poz"><%= c.poz %></span> <%= c.nume %></h2>
    <div class="doc-sub2">
      <%= c.dimensiuni %> mm ·
      PAL <%= c.params.t %> mm ·
      <%= [+c.params.nUsi ? t('corpuri.metaUsi', { n: +c.params.nUsi }) : null,
           +c.params.nSer ? t('corpuri.metaSertare', { n: +c.params.nSer }) : null,
           +c.params.nPol ? t('corpuri.metaPolite', { n: +c.params.nPol }) : null,
           +c.params.faraFront ? t('rezumat.faraFront') : null
          ].filter(Boolean).join(' · ') || t('print.corpDeschis') %>
      · <%= c.params.spate === 'aplicat' ? t('print.spateAplicat') : t('print.spateNut') %>
    </div>

    <% if (c.avertismente.length) { %>
      <div class="doc-warn"><% c.avertismente.forEach(function (w) { %><div>⚠ <%= w %></div><% }); %></div>
    <% } %>

    <div class="doc-doua">
      <div>
        <h3><%= t('print.piese') %></h3>
        <table class="doc-tbl mic">
          <thead><tr>
            <th class="num"><%= t('print.colCod') %></th><th><%= t('print.colPiesa') %></th>
            <th class="num"><%= t('print.colBuc') %></th>
            <th class="num"><%= t('print.colFinit') %></th><th class="num"><%= t('print.colTaiere') %></th>
            <th><%= t('print.colCant') %></th>
          </tr></thead>
          <tbody>
            <% c.piese.forEach(function (p) { %>
              <tr>
                <td class="num"><%= p.cod %></td>
                <td><%= p.nume %>
                  <% if (p.nota) { %><div class="tag"><%= p.nota %></div><% } %>
                </td>
                <td class="num"><%= p.buc %></td>
                <td class="num"><%= p.L %> × <%= p.l %></td>
                <td class="num"><b><%= p.TL %> × <%= p.Tl %></b></td>
                <td class="small"><%= p.cant.special ? t('comanda.muchiiFrontale') : p.cant.muchii.join('·') %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <div>
        <h3><%= t('print.feronerie') %></h3>
        <table class="doc-tbl mic">
          <thead><tr><th><%= t('comun.articol') %></th><th class="num"><%= t('comun.cant') %></th></tr></thead>
          <tbody>
            <% c.feronerie.forEach(function (f) { %>
              <tr>
                <td><%= f.nume %><% if (f.obs) { %><div class="tag"><%= f.obs %></div><% } %></td>
                <td class="num"><b><%= f.qty %></b> <%= f.um %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>

        <h3><%= t('print.ordineaMontaj') %></h3>
        <ol class="doc-pasi">
          <li><%= t('print.pasCant') %></li>
          <li><%= t('print.pasGauri', { sistem: raport.sistemFeronerie.asamblare.nume }) %></li>
          <% if (+c.params.nPol) { %><li><%= t('print.pasPolite') %></li><% } %>
          <li><%= t('print.pasCarcasa') %></li>
          <li><%= t('print.pasSpate') %></li>
          <% if (+c.params.nSer) { %><li><%= t('print.pasSertare') %></li><% } %>
          <%# Pasul cu usile se sare cand nu se fac: un montator care citeste
              „pune usile" si n-are ce pune sta si cauta niste canaturi care
              nu exista. Cutiile de sertar RAMAN — alea se fac oricum. %>
          <% if (+c.params.nUsi && !+c.params.faraFront) { %><li><%= t('print.pasUsi') %></li><% } %>
          <% if (raport.sistemFeronerie.suspensii && +c.params.D <= 450) { %>
            <li><%= t('print.pasSuspensii') %></li>
          <% } %>
        </ol>
      </div>
    </div>
  </section>
<% }); %>

<section class="doc-sect">
  <h2><%= t('print.feronerieTotal') %></h2>
  <table class="doc-tbl">
    <thead><tr><th><%= t('comun.articol') %></th><th class="num"><%= t('comun.cantitate') %></th>
      <th><%= t('print.colObservatii') %></th></tr></thead>
    <tbody>
      <% raport.feronerie.forEach(function (f) { %>
        <tr><td><%= f.nume %></td><td class="num"><b><%= f.qty %></b> <%= f.um %></td>
            <td class="small"><%= f.obs %></td></tr>
      <% }); %>
    </tbody>
  </table>
</section>
