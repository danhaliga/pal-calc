<div class="top">
  <div>
    <div class="crumbs"><a href="/orders">← Comenzile mele</a></div>
    <h1><%= order.name %></h1>
    <div class="muted small">
      Comanda nr. <%= order.id %> · deschisă <%= order.created_at.slice(0, 10) %>
      · <%= raport.totaluri.corpuri %> corpuri · <%= raport.totaluri.bucati %> piese
      <%= order.note ? ' · ' + order.note : '' %>
    </div>
  </div>
  <div class="btns" style="margin:0">
    <a class="btn primary" href="/orders/<%= order.id %>/corp-nou">+ Adaugă corp (<%= (pretCorp / 100).toFixed(2) %> lei)</a>
    <a class="btn" href="/credit">Credit: <b><%= (sold / 100).toFixed(2) %> lei</b></a>
  </div>
</div>

<% if (adaugat) { %><div class="warn ok">Corpul a fost adăugat în comandă.</div><% } %>
<% if (sold < pretCorp) { %>
  <div class="warn err">Creditul nu mai ajunge pentru un corp nou. <a href="/credit">Alimentează</a>.</div>
<% } %>
<% raport.avertismente.forEach(function (a) { %>
  <div class="warn"><%= a %></div>
<% }); %>

<!-- ---------------- materialele comenzii ---------------- -->
<div class="panel" id="materiale">
  <div class="top" style="margin-bottom:8px">
    <h2 style="margin:0">Materiale (<%= materiale.length %>)</h2>
    <button class="btn small primary" type="button" onclick="document.getElementById('matNou').classList.toggle('hidden')">
      + Material
    </button>
  </div>

  <div class="tbl"><table>
    <thead><tr>
      <th></th><th>Nume</th><th>Rol</th><th>Decor</th><th class="num">PAL</th>
      <th class="num">Cant gros</th><th class="num">Cant subțire</th><th></th>
    </tr></thead>
    <tbody>
      <% materiale.forEach(function (m) { %>
        <tr>
          <td><span class="decor-sw" style="background:<%= m.hex || '#cfd6dd' %>"></span></td>
          <td><b><%= m.nume %></b></td>
          <td class="small"><%= (roluri.find(function (r) { return r.id === m.rol; }) || {}).nume || m.rol %></td>
          <td class="small"><%= m.brand %> <%= m.decor_cod || '' %> <%= m.decor_nume || '' %></td>
          <td class="num"><%= m.pal_mm %> mm</td>
          <td class="num"><%= m.cant_gros %> mm</td>
          <td class="num"><%= m.cant_subtire %> mm</td>
          <td class="num">
            <details class="inline-edit">
              <summary class="btn small">Modifică</summary>
              <form method="post" action="/orders/<%= order.id %>/materials/<%= m.id %>" class="mat-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="f3">
                  <label>Nume<input type="text" name="nume" value="<%= m.nume %>" maxlength="60" required></label>
                  <label>Rol<select name="rol">
                    <% roluri.forEach(function (r) { %>
                      <option value="<%= r.id %>" <%= m.rol === r.id ? 'selected' : '' %>><%= r.nume %></option>
                    <% }); %>
                  </select></label>
                  <label>Producător<select name="brand" id="brand-<%= m.id %>">
                    <% marci.forEach(function (b) { %>
                      <option value="<%= b %>" <%= m.brand === b ? 'selected' : '' %>><%= b %></option>
                    <% }); %>
                  </select></label>
                  <label>Grosime PAL<select name="pal_mm" id="pal-<%= m.id %>">
                    <% grosimi.forEach(function (g) { %>
                      <option value="<%= g %>" <%= Number(m.pal_mm) === g ? 'selected' : '' %>><%= g %> mm</option>
                    <% }); %>
                  </select></label>
                  <label>Cant gros<select name="cant_gros" id="cg-<%= m.id %>">
                    <% cantStandard.forEach(function (c) { %>
                      <option value="<%= c %>" <%= Number(m.cant_gros) === c ? 'selected' : '' %>><%= c %> mm</option>
                    <% }); %>
                  </select></label>
                  <label>Cant subțire<select name="cant_subtire" id="cs-<%= m.id %>">
                    <% cantStandard.forEach(function (c) { %>
                      <option value="<%= c %>" <%= Number(m.cant_subtire) === c ? 'selected' : '' %>><%= c %> mm</option>
                    <% }); %>
                  </select></label>
                </div>
                <label style="margin-top:8px">Decor
                  <%- include('../partials/decor-picker', { p: { brandId: 'brand-' + m.id, palId: 'pal-' + m.id,
                        cantGrosId: 'cg-' + m.id, cantSubtireId: 'cs-' + m.id, valoare: m.decor_cod } }) %>
                </label>
                <div class="btns">
                  <button class="btn small primary" type="submit">Salvează</button>
                  <% if (materiale.length > 1) { %>
                    <button class="btn small danger" type="submit" name="sterge" value="1"
                            onclick="return confirm('Ștergi materialul?')">Șterge</button>
                  <% } %>
                </div>
              </form>
            </details>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table></div>

  <div id="matNou" class="hidden" style="margin-top:14px">
    <form method="post" action="/orders/<%= order.id %>/materials" class="mat-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="f3">
        <label>Nume<input type="text" name="nume" placeholder="ex: Fronturi stejar" maxlength="60" required></label>
        <label>Rol<select name="rol">
          <% roluri.forEach(function (r) { %><option value="<%= r.id %>"><%= r.nume %></option><% }); %>
        </select></label>
        <label>Producător<select name="brand" id="brand-nou">
          <% marci.forEach(function (b) { %><option value="<%= b %>"><%= b %></option><% }); %>
        </select></label>
        <label>Grosime PAL<select name="pal_mm" id="pal-nou">
          <% grosimi.forEach(function (g) { %>
            <option value="<%= g %>" <%= g === 18 ? 'selected' : '' %>><%= g %> mm</option>
          <% }); %>
        </select></label>
        <label>Cant gros<select name="cant_gros" id="cg-nou">
          <% cantStandard.forEach(function (c) { %>
            <option value="<%= c %>" <%= c === 2 ? 'selected' : '' %>><%= c %> mm</option>
          <% }); %>
        </select></label>
        <label>Cant subțire<select name="cant_subtire" id="cs-nou">
          <% cantStandard.forEach(function (c) { %>
            <option value="<%= c %>" <%= c === 0.4 ? 'selected' : '' %>><%= c %> mm</option>
          <% }); %>
        </select></label>
      </div>
      <label style="margin-top:8px">Decor
        <%- include('../partials/decor-picker', { p: { brandId: 'brand-nou', palId: 'pal-nou',
              cantGrosId: 'cg-nou', cantSubtireId: 'cs-nou', valoare: '' } }) %>
      </label>
      <button class="btn primary" type="submit" style="margin-top:10px">Adaugă materialul</button>
    </form>
  </div>
</div>

<!-- ---------------- setările comenzii ---------------- -->
<details class="panel">
  <summary><b>Setări comandă:</b> formate de coală —
    <%= formateAlese.map(function (f) { return formateToate[f].nume; }).join(', ') %>
  </summary>
  <form method="post" action="/orders/<%= order.id %>" style="margin-top:12px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="f">
      <label class="full">Nume comandă<input type="text" name="name" value="<%= order.name %>" maxlength="80" required></label>
      <label class="full">Observații<input type="text" name="note" value="<%= order.note || '' %>" maxlength="500"></label>
    </div>
    <div class="formate" style="margin-top:10px">
      <% formateId.forEach(function (f) { %>
        <label class="check">
          <input type="checkbox" name="formate" value="<%= f %>"
                 <%= formateAlese.indexOf(f) !== -1 ? 'checked' : '' %>>
          <%= formateToate[f].nume %>
        </label>
      <% }); %>
    </div>
    <div class="btns">
      <button class="btn primary" type="submit">Salvează</button>
      <button class="btn danger" type="submit" formaction="/orders/<%= order.id %>/delete"
              onclick="return confirm('Ștergi comanda și toate corpurile ei?')">Șterge comanda</button>
    </div>
  </form>
</details>

<!-- ---------------- corpurile ---------------- -->
<div class="panel">
  <div class="top" style="margin-bottom:8px">
    <h2 style="margin:0">Corpuri în comandă</h2>
    <a class="btn small primary" href="/orders/<%= order.id %>/corp-nou">+ Adaugă corp</a>
  </div>

  <% if (!raport.corpuri.length) { %>
    <p class="muted">Niciun corp încă. Apasă „Adaugă corp”, alege un model și modifică-i cotele.</p>
  <% } else { %>
    <div class="tbl"><table>
      <thead><tr>
        <th class="num">#</th><th>Corp</th><th>Dimensiuni</th><th class="num">Piese</th>
        <th>Material carcasă</th><th>Material fronturi</th><th></th>
      </tr></thead>
      <tbody>
        <% raport.corpuri.forEach(function (c) { %>
          <tr>
            <td class="num"><%= c.poz %></td>
            <td>
              <a href="/corps/<%= c.id %>"><b><%= c.nume %></b></a>
              <% if (c.avertismente.length) { %>
                <div class="tag" style="color:var(--cant)">⚠ <%= c.avertismente[0] %></div>
              <% } %>
            </td>
            <td class="num"><%= c.dimensiuni %></td>
            <td class="num"><%= c.bucati %></td>
            <td colspan="2">
              <form method="post" action="/corps/<%= c.id %>/material" class="mat-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <select name="mat_corp_id" onchange="this.form.submit()">
                  <% materiale.forEach(function (m) { %>
                    <option value="<%= m.id %>" <%= c.materialCorp && c.materialCorp.id === m.id ? 'selected' : '' %>>
                      <%= m.nume %>
                    </option>
                  <% }); %>
                </select>
                <select name="mat_front_id" onchange="this.form.submit()">
                  <option value="">— ca la carcasă —</option>
                  <% materiale.forEach(function (m) { %>
                    <option value="<%= m.id %>" <%= c.materialFront && c.materialFront.id === m.id && c.materialCorp && c.materialCorp.id !== m.id ? 'selected' : '' %>>
                      <%= m.nume %>
                    </option>
                  <% }); %>
                </select>
              </form>
            </td>
            <td class="num">
              <a class="btn small" href="/corps/<%= c.id %>">Editează</a>
              <form method="post" action="/corps/<%= c.id %>/duplicate" class="inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn small" type="submit"
                        title="Copia se plătește ca orice corp nou">Duplică (<%= (pretCorp / 100).toFixed(2) %> lei)</button>
              </form>
              <button class="btn small danger" data-delete="<%= c.id %>" data-name="<%= c.nume %>">Șterge</button>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table></div>
  <% } %>
</div>

<% if (raport.corpuri.length) { %>
<!-- ---------------- necesar ---------------- -->
<div class="panel">
  <div class="top" style="margin-bottom:8px">
    <h2 style="margin:0">Necesar de materiale</h2>
    <div class="btns" style="margin:0">
      <a class="btn small" href="/orders/<%= order.id %>/print/corpuri">Listă corpuri</a>
      <a class="btn small primary" href="/orders/<%= order.id %>/print/debitare">Listă debitare</a>
      <a class="btn small" href="/orders/<%= order.id %>/print/incadrare">Încadrare în coli</a>
      <a class="btn small" href="/orders/<%= order.id %>/print/montaj">Fișe montaj</a>
      <% if (raport.cnc.length) { %>
        <a class="btn small" href="/orders/<%= order.id %>/print/cnc">CNC (<%= raport.cnc.length %>)</a>
      <% } %>
      <a class="btn small" href="/orders/<%= order.id %>/export.csv">CSV</a>
    </div>
  </div>

  <div class="tbl"><table>
    <thead><tr>
      <th></th><th>Material</th><th class="num">Piese</th><th class="num">m² piese</th>
      <th>Coli folosite</th><th class="num">Echivalent</th><th class="num">De cumpărat</th><th class="num">Deșeu</th>
    </tr></thead>
    <tbody>
      <% raport.materiale.forEach(function (m) { %>
        <tr>
          <td><span class="decor-sw" style="background:<%= m.hex || '#cfd6dd' %>"></span></td>
          <td><b><%= m.nume %></b></td>
          <td class="num"><%= m.bucati %></td>
          <td class="num"><%= m.m2piese %></td>
          <td class="small">
            <%= m.bucatiColi.map(function (b) { return b.n + ' × ' + b.format.nume; }).join(' + ') %>
          </td>
          <td class="num"><%= m.echivalent %> coli</td>
          <td class="num"><b><%= m.coliIntregi %></b> coli întregi</td>
          <td class="num"><%= m.deseuPct %>%</td>
        </tr>
      <% }); %>
    </tbody>
  </table></div>

  <h2 style="margin-top:16px">Cant</h2>
  <div class="tbl"><table>
    <thead><tr><th>Grosime</th><th>Decor</th><th class="num">Metri liniari</th></tr></thead>
    <tbody>
      <% raport.cant.linii.forEach(function (c) { %>
        <tr>
          <td><b><%= c.mm %> mm</b></td>
          <td class="small"><%= c.decor %></td>
          <td class="num"><b><%= c.ml %></b> ml</td>
        </tr>
      <% }); %>
    </tbody>
    <tfoot><tr><td colspan="2"><b>Total</b></td><td class="num"><b><%= raport.cant.total %> ml</b></td></tr></tfoot>
  </table></div>

  <div class="doua-coloane" style="margin-top:16px">
    <div>
      <h2>Feronerie (estimativ)</h2>
      <div class="tbl"><table>
        <thead><tr><th>Articol</th><th class="num">Cant.</th><th>Obs.</th></tr></thead>
        <tbody>
          <% raport.feronerie.forEach(function (f) { %>
            <tr><td><%= f.nume %></td><td class="num"><b><%= f.qty %></b> <%= f.um %></td>
                <td class="muted small"><%= f.obs %></td></tr>
          <% }); %>
        </tbody>
      </table></div>
    </div>

    <div>
      <h2>Prelucrări după debitare</h2>
      <% if (!raport.cnc.length) { %>
        <p class="muted small">Nicio piesă nu are nevoie de CNC: toate se taie drept.</p>
      <% } else { %>
        <div class="tbl"><table>
          <thead><tr><th>Corp</th><th>Piesă</th><th>Operație</th></tr></thead>
          <tbody>
            <% raport.cnc.forEach(function (x) { %>
              <tr><td class="small"><%= x.corp %></td><td class="small"><%= x.piesa %></td>
                  <td class="small"><%= x.tip %></td></tr>
            <% }); %>
          </tbody>
        </table></div>
        <p class="hint">Planșele cotate sunt în <a href="/orders/<%= order.id %>/print/cnc">lista CNC</a>.</p>
      <% } %>
    </div>
  </div>
</div>

<!-- ---------------- piesele ---------------- -->
<div class="panel">
  <div class="top" style="margin-bottom:8px">
    <h2 style="margin:0">Piese de debitat (<%= raport.totaluri.bucati %> bucăți)</h2>
    <a class="btn small primary" href="/orders/<%= order.id %>/print/debitare">Deschide lista de tipărit</a>
  </div>
  <div class="tbl"><table>
    <thead><tr>
      <th>Cod</th><th>Corp</th><th>Piesă</th><th class="num">Buc</th>
      <th class="num">Tăiere L</th><th class="num">Tăiere l</th>
      <th>Cant L1·L2·l1·l2</th><th>Material</th><th>Fibră</th>
    </tr></thead>
    <tbody>
      <% raport.piese.forEach(function (p) { %>
        <tr>
          <td class="num"><%= p.cod %></td>
          <td class="small"><%= p.corpNume %></td>
          <td><%= p.nume %><% if (p.cnc) { %> <span class="chip cnc">CNC</span><% } %></td>
          <td class="num"><%= p.buc %></td>
          <td class="num"><b><%= p.TL %></b></td>
          <td class="num"><b><%= p.Tl %></b></td>
          <td class="small"><%= p.cant.special ? 'muchii frontale' : p.cant.muchii.join(' · ') %></td>
          <td class="small">
            <span class="decor-sw mic" style="background:<%= p.material.hex || '#cfd6dd' %>"></span>
            <%= p.material.tip %> <%= p.material.gros %>
          </td>
          <td class="small"><%= p.fibra %></td>
        </tr>
      <% }); %>
    </tbody>
  </table></div>
</div>
<% } %>

<script type="application/json" id="page-data"><%- jsonPentruPagina({ csrf: csrfToken }) %></script>
<script src="/static/corps-list.js?v=<%= assetV %>"></script>
<script src="/static/decor.js?v=<%= assetV %>"></script>
