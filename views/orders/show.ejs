<div class="top">
  <div>
    <div class="crumbs"><a href="/orders">← <%= t('comanda.inapoiComenzi') %></a></div>
    <h1><%= order.name %></h1>
    <div class="muted small">
      <%= t('comanda.antet', { id: order.id, data: order.created_at.slice(0, 10) }) %>
      · <%= t('comenzi.nrCorpuri', { n: raport.totaluri.corpuri }) %>
      · <%= t('comanda.colPiese') %>: <%= raport.totaluri.bucati %>
      <%= order.note ? ' · ' + order.note : '' %>
    </div>
    <%# Livrarea si telefonul stau in antet, nu pliate in setari: de ele se
        loveste omul cel mai des cand deschide comanda. %>
    <% if (order.livrare_la || order.telefon) { %>
      <div class="livrare">
        <% if (order.livrare_la) { %>
          <span class="chip"><%= t('comanda.livrareLa') %>: <b><%= order.livrare_la %></b></span>
        <% } %>
        <% if (order.telefon) { %>
          <span class="chip"><a href="tel:<%= order.telefon.replace(/[^+0-9]/g, '') %>"><%= order.telefon %></a></span>
        <% } %>
      </div>
    <% } %>
  </div>
  <div class="btns" style="margin:0">
    <a class="btn primary" href="/orders/<%= order.id %>/corp-nou"><%= t('comanda.adaugaCorp', { pret: (pretCorp / 100).toFixed(2) }) %></a>
    <a class="btn" href="/credit"><%- t('comenzi.creditButon', { sold: (sold / 100).toFixed(2) }) %></a>
  </div>
</div>

<% if (adaugat) { %><div class="warn ok"><%= t('comanda.corpAdaugat') %></div><% } %>
<% if (sold < pretCorp) { %>
  <div class="warn err"><%- t('comanda.faraCredit') %></div>
<% } %>
<% raport.avertismente.forEach(function (a) { %>
  <div class="warn"><%= a %></div>
<% }); %>

<!-- ---------------- materialele comenzii ---------------- -->
<div class="panel" id="materiale">
  <div class="top" style="margin-bottom:8px">
    <h2 style="margin:0"><%= t('comanda.materiale', { n: materiale.length }) %></h2>
    <button class="btn small primary" type="button" data-comuta="matNou"><%= t('comanda.materialNou') %></button>
  </div>

  <div class="tbl"><table>
    <thead><tr>
      <th></th><th><%= t('comanda.colNume') %></th><th><%= t('comanda.colRol') %></th>
      <th><%= t('comanda.colDecor') %></th><th class="num"><%= t('comanda.colPal') %></th>
      <th class="num"><%= t('comanda.colCantGros') %></th>
      <th class="num"><%= t('comanda.colCantSubtire') %></th><th></th>
    </tr></thead>
    <tbody>
      <% materiale.forEach(function (m) { %>
        <tr>
          <td><span class="decor-sw" style="background:<%= m.hex || '#cfd6dd' %>"></span></td>
          <td><b><%= m.nume %></b></td>
          <td class="small"><%= (roluri.find(function (r) { return r.id === m.rol; }) || {}).nume || m.rol %></td>
          <td class="small"><%= m.brand %> <%= m.decor_cod || '' %> <%= m.decor_nume || '' %></td>
          <td class="num"><%= m.pal_mm %> mm</td>
          <td class="num"><%= m.cant_gros %> mm</td>
          <td class="num"><%= m.cant_subtire %> mm</td>
          <td class="num">
            <details class="inline-edit">
              <summary class="btn small"><%= t('comun.modifica') %></summary>
              <form method="post" action="/orders/<%= order.id %>/materials/<%= m.id %>" class="mat-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="f3">
                  <label><%= t('comanda.colNume') %><input type="text" name="nume" id="nume-<%= m.id %>"
                         value="<%= m.nume %>" maxlength="60"
                         placeholder="<%= t('comanda.numeDinDecor') %>"></label>
                  <label><%= t('comanda.colRol') %><select name="rol">
                    <% roluri.forEach(function (r) { %>
                      <option value="<%= r.id %>" <%= m.rol === r.id ? 'selected' : '' %>><%= r.nume %></option>
                    <% }); %>
                  </select></label>
                  <label><%= t('comanda.producator') %><select name="brand" id="brand-<%= m.id %>">
                    <% marci.forEach(function (b) { %>
                      <option value="<%= b %>" <%= m.brand === b ? 'selected' : '' %>><%= b %></option>
                    <% }); %>
                  </select></label>
                  <label><%= t('comanda.grosimePal') %><select name="pal_mm" id="pal-<%= m.id %>">
                    <% grosimi.forEach(function (g) { %>
                      <option value="<%= g %>" <%= Number(m.pal_mm) === g ? 'selected' : '' %>><%= g %> mm</option>
                    <% }); %>
                  </select></label>
                  <%# `cantPentru` adauga grosimea deja salvata daca nu mai e
                      in fabricatie. Fara ea, deschiderea unei comenzi vechi
                      i-ar schimba cantul in tacere la prima salvare. %>
                  <label><%= t('comanda.colCantGros') %><select name="cant_gros" id="cg-<%= m.id %>">
                    <% cantPentru(m.cant_gros).forEach(function (c) { %>
                      <option value="<%= c %>" <%= Number(m.cant_gros) === c ? 'selected' : '' %>><%= c %> mm<%=
                        cantScos.indexOf(c) !== -1 ? ' · ' + t('comanda.cantScos') : '' %></option>
                    <% }); %>
                  </select></label>
                  <label><%= t('comanda.colCantSubtire') %><select name="cant_subtire" id="cs-<%= m.id %>">
                    <% cantPentru(m.cant_subtire).forEach(function (c) { %>
                      <option value="<%= c %>" <%= Number(m.cant_subtire) === c ? 'selected' : '' %>><%= c %> mm<%=
                        cantScos.indexOf(c) !== -1 ? ' · ' + t('comanda.cantScos') : '' %></option>
                    <% }); %>
                  </select></label>
                </div>
                <label style="margin-top:8px"><%= t('comanda.colDecor') %>
                  <%- include('../partials/decor-picker', { p: { brandId: 'brand-' + m.id, palId: 'pal-' + m.id,
                        cantGrosId: 'cg-' + m.id, cantSubtireId: 'cs-' + m.id,
                        numeId: 'nume-' + m.id, valoare: m.decor_cod } }) %>
                </label>
                <div class="btns">
                  <button class="btn small primary" type="submit"><%= t('comun.salveaza') %></button>
                  <% if (materiale.length > 1) { %>
                    <button class="btn small danger" type="submit" name="sterge" value="1"
                            data-confirma="<%= t('comanda.stergeMaterial') %>"><%= t('comun.sterge') %></button>
                  <% } %>
                </div>
              </form>
            </details>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table></div>

  <div id="matNou" class="hidden" style="margin-top:14px">
    <form method="post" action="/orders/<%= order.id %>/materials" class="mat-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="f3">
        <label><%= t('comanda.colRol') %><select name="rol">
          <% roluri.forEach(function (r) { %><option value="<%= r.id %>"><%= r.nume %></option><% }); %>
        </select></label>
        <label><%= t('comanda.producator') %><select name="brand" id="brand-nou">
          <% marci.forEach(function (b) { %><option value="<%= b %>"><%= b %></option><% }); %>
        </select></label>
        <label><%= t('comanda.grosimePal') %><select name="pal_mm" id="pal-nou">
          <% grosimi.forEach(function (g) { %>
            <option value="<%= g %>" <%= g === 18 ? 'selected' : '' %>><%= g %> mm</option>
          <% }); %>
        </select></label>
        <label><%= t('comanda.colCantGros') %><select name="cant_gros" id="cg-nou">
          <% cantStandard.forEach(function (c) { %>
            <option value="<%= c %>" <%= c === 2 ? 'selected' : '' %>><%= c %> mm</option>
          <% }); %>
        </select></label>
        <label><%= t('comanda.colCantSubtire') %><select name="cant_subtire" id="cs-nou">
          <% cantStandard.forEach(function (c) { %>
            <option value="<%= c %>" <%= c === 0.4 ? 'selected' : '' %>><%= c %> mm</option>
          <% }); %>
        </select></label>
      </div>
      <label style="margin-top:8px"><%= t('comanda.colDecor') %>
        <%- include('../partials/decor-picker', { p: { brandId: 'brand-nou', palId: 'pal-nou',
              cantGrosId: 'cg-nou', cantSubtireId: 'cs-nou', numeId: 'nume-nou', valoare: '' } }) %>
      </label>
      <%# Numele stă DUPĂ decor și se umple din el: nimeni nu știe cum se
          cheamă placa înainte s-o aleagă. Se poate rescrie, dacă omul are
          alt fel de-a le striga în atelier. %>
      <label style="margin-top:8px"><%= t('comanda.colNume') %>
        <input type="text" name="nume" id="nume-nou" maxlength="60"
               placeholder="<%= t('comanda.numeDinDecor') %>">
      </label>
      <button class="btn primary" type="submit" style="margin-top:10px"><%= t('comanda.adaugaMaterialul') %></button>
    </form>
  </div>
</div>

<!-- ---------------- setările comenzii ---------------- -->
<details class="panel">
  <summary><b><%= t('comanda.setari') %></b> <%= t('comanda.setariFormate') %>
    <%= formateAlese.map(function (f) { return formateToate[f].nume; }).join(', ') %>
  </summary>
  <form method="post" action="/orders/<%= order.id %>" style="margin-top:12px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="f">
      <label class="full"><%= t('comanda.numeComanda') %><input type="text" name="name" value="<%= order.name %>" maxlength="80" required></label>
      <label class="full"><%= t('comanda.observatii') %><input type="text" name="note" value="<%= order.note || '' %>" maxlength="500"></label>
    </div>
    <div class="f3" style="margin-top:8px">
      <label><%= t('comanda.livrareLa') %>
        <input type="date" name="livrare_la" value="<%= order.livrare_la || '' %>">
      </label>
      <label><%= t('comanda.telefon') %>
        <input type="tel" name="telefon" maxlength="40" autocomplete="tel"
               placeholder="<%= t('comanda.telefonExemplu') %>" value="<%= order.telefon || '' %>">
      </label>
    </div>
    <div class="formate" style="margin-top:10px">
      <% formateId.forEach(function (f) { %>
        <label class="check">
          <input type="checkbox" name="formate" value="<%= f %>"
                 <%= formateAlese.indexOf(f) !== -1 ? 'checked' : '' %>>
          <%= formateToate[f].nume %>
        </label>
      <% }); %>
    </div>
    <div class="btns">
      <button class="btn primary" type="submit"><%= t('comun.salveaza') %></button>
    </div>
  </form>
</details>

<!-- ---------------- feroneria comenzii ---------------- -->
<%# Strans, ca setarile de deasupra. Sistemul se alege la deschiderea
    comenzii, in formularul de comanda noua; aici se schimba rar, iar un
    panou de trei ecrane deschis din start impinge corpurile jos. %>
<details class="panel" id="feronerie" <%= deschideFeronerie ? 'open' : '' %>>
  <summary><b><%= t('fero.rezumat') %></b>
    <%= feroSistem.asamblare.nume %> ·
    <%= feroSistem.balama ? feroSistem.balama.nume : t('fero.faraBalamale') %> ·
    <%= feroSistem.glisiere ? feroSistem.glisiere.nume : t('fero.faraGlisiere') %><%= feroSistem.suspensii ? ' · ' + t('fero.cuSuspensii') : '' %>
  </summary>
  <form method="post" action="/orders/<%= order.id %>/feronerie" style="margin-top:12px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('../partials/feronerie-form', { f: feroOptiuni, ales: feroAles }) %>
    <button class="btn primary" type="submit"><%= t('fero.salveaza') %></button>
    <p class="legend"><%= t('fero.notaSchimbare') %></p>
  </form>
</details>

<!-- ---------------- corpurile ---------------- -->
<div class="panel">
  <%# Comanda fara fronturi: cine-si cumpara usile in alta parte le cumpara
      pe toate, deci se apasa o data pentru toata comanda. Se poate si
      inapoi, cu aceeasi apasare. %>
  <% var faraTot = raport.corpuri.length &&
       raport.corpuri.every(function (c) { return +c.params.faraFront; }); %>
  <div class="top" style="margin-bottom:8px">
    <h2 style="margin:0"><%= t('comanda.corpuriInComanda') %></h2>
    <div class="btns" style="margin:0">
      <% if (raport.corpuri.length) { %>
        <form method="post" action="/orders/<%= order.id %>/fronturi" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="fara" value="<%= faraTot ? '0' : '1' %>">
          <button class="btn small" type="submit"><%= faraTot
            ? t('comanda.puneFronturileInapoi')
            : t('comanda.toateFaraFronturi') %></button>
        </form>
      <% } %>
      <a class="btn small primary" href="/orders/<%= order.id %>/corp-nou"><%= t('comanda.adaugaCorpScurt') %></a>
    </div>
  </div>

  <% if (!raport.corpuri.length) { %>
    <p class="muted"><%= t('comanda.niciunCorp') %></p>
  <% } else { %>
    <div class="tbl"><table>
      <thead><tr>
        <th class="num">#</th><th class="c"></th><th><%= t('comanda.colCorp') %></th><th><%= t('comanda.colDimensiuni') %></th>
        <th class="num"><%= t('comanda.colPiese') %></th>
        <th><%= t('comanda.colMaterialCarcasa') %></th><th><%= t('comanda.colMaterialFronturi') %></th><th></th>
      </tr></thead>
      <tbody>
        <% raport.corpuri.forEach(function (c) { %>
          <tr>
            <td class="num"><%= c.poz %></td>
            <%# Desenul vine din acelasi loc ca in catalogul de modele, deci
                arata la fel peste tot si se schimba odata cu corpul. %>
            <td class="c"><a class="sk-mic" href="/corps/<%= c.id %>"
               aria-hidden="true" tabindex="-1"><%- c.desen %></a></td>
            <td>
              <a href="/corps/<%= c.id %>"><b><%= c.nume %></b></a>
              <% if (c.avertismente.length) { %>
                <div class="tag" style="color:var(--cant)">⚠ <%= c.avertismente[0] %></div>
              <% } %>
            </td>
            <td class="num"><%= c.dimensiuni %></td>
            <td class="num"><%= c.bucati %></td>
            <td colspan="2">
              <form method="post" action="/corps/<%= c.id %>/material" class="mat-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <select name="mat_corp_id" data-trimite-la-schimbare
                        aria-label="<%= t('comanda.colMaterialCarcasa') %>">
                  <% materiale.forEach(function (m) { %>
                    <option value="<%= m.id %>" <%= c.materialCorp && c.materialCorp.id === m.id ? 'selected' : '' %>>
                      <%= m.nume %>
                    </option>
                  <% }); %>
                </select>
                <select name="mat_front_id" data-trimite-la-schimbare
                        aria-label="<%= t('comanda.colMaterialFronturi') %>">
                  <option value=""><%= t('comanda.caLaCarcasa') %></option>
                  <% materiale.forEach(function (m) { %>
                    <option value="<%= m.id %>" <%= c.materialFront && c.materialFront.id === m.id && c.materialCorp && c.materialCorp.id !== m.id ? 'selected' : '' %>>
                      <%= m.nume %>
                    </option>
                  <% }); %>
                  <%# Lipsa materialului e tot un raspuns la „din ce sunt
                      usile”: din nimic, ca nu se fac. Sta la coada, dupa
                      decoruri, fiindca e alegerea rara. %>
                  <option value="fara" <%= +c.params.faraFront ? 'selected' : '' %>><%= t('comanda.faraFronturi') %></option>
                </select>
              </form>
            </td>
            <td class="num">
              <a class="btn small" href="/corps/<%= c.id %>"><%= t('comanda.editeaza') %></a>
              <form method="post" action="/corps/<%= c.id %>/duplicate" class="inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn small" type="submit"
                        title="<%= t('corpuri.duplicaTitlu') %>"><%= t('corpuri.duplica', { pret: (pretCorp / 100).toFixed(2) }) %></button>
              </form>
              <button class="btn small danger" data-delete="<%= c.id %>" data-name="<%= c.nume %>"><%= t('comun.sterge') %></button>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table></div>
  <% } %>
</div>

<% if (raport.corpuri.length) { %>
<!-- ---------------- necesar ---------------- -->
<div class="panel">
  <div class="top" style="margin-bottom:8px">
    <h2 style="margin:0"><%= t('comanda.necesar') %></h2>
    <div class="btns" style="margin:0">
      <a class="btn small" href="/orders/<%= order.id %>/ansamblu"><%= t('comanda.linkAnsamblu') %></a>
      <a class="btn small" href="/orders/<%= order.id %>/print/corpuri"><%= t('comanda.linkCorpuri') %></a>
      <a class="btn small primary" href="/orders/<%= order.id %>/print/debitare"><%= t('comanda.linkDebitare') %></a>
      <a class="btn small" href="/orders/<%= order.id %>/print/incadrare"><%= t('comanda.linkIncadrare') %></a>
      <a class="btn small" href="/orders/<%= order.id %>/print/montaj"><%= t('comanda.linkMontaj') %></a>
      <% if (raport.cnc.length) { %>
        <a class="btn small" href="/orders/<%= order.id %>/print/cnc"><%= t('comanda.linkCnc', { n: raport.cnc.length }) %></a>
      <% } %>
      <a class="btn small" href="/orders/<%= order.id %>/export.xlsx" download>Excel</a>
      <a class="btn small" href="/orders/<%= order.id %>/proiect.zip" download><%= t('comanda.descarcaProiect') %></a>
    </div>
  </div>

  <div class="tbl"><table>
    <thead><tr>
      <th></th><th><%= t('comanda.colMaterial') %></th><th class="num"><%= t('comanda.colPiese') %></th>
      <th class="num"><%= t('comanda.colM2') %></th>
      <th><%= t('comanda.colColiFolosite') %></th><th class="num"><%= t('comanda.colEchivalent') %></th>
      <th class="num"><%= t('comanda.colDeCumparat') %></th><th class="num"><%= t('comanda.colDeseu') %></th>
    </tr></thead>
    <tbody>
      <% raport.materiale.forEach(function (m) { %>
        <tr>
          <td><span class="decor-sw" style="background:<%= m.hex || '#cfd6dd' %>"></span></td>
          <td><b><%= m.nume %></b></td>
          <td class="num"><%= m.bucati %></td>
          <td class="num"><%= m.m2piese %></td>
          <td class="small">
            <%= m.bucatiColi.map(function (b) { return b.n + ' × ' + b.format.nume; }).join(' + ') %>
          </td>
          <td class="num"><%= t('comanda.nColi', { n: m.echivalent }) %></td>
          <td class="num"><b><%= t('comanda.nColiIntregi', { n: m.coliIntregi }) %></b></td>
          <td class="num"><%= m.deseuPct %>%</td>
        </tr>
      <% }); %>
    </tbody>
  </table></div>

  <h2 style="margin-top:16px"><%= t('comanda.cant') %></h2>
  <div class="tbl"><table>
    <thead><tr><th><%= t('comanda.colGrosime') %></th><th><%= t('comanda.colDecor') %></th>
      <th class="num"><%= t('comanda.colMetriLiniari') %></th></tr></thead>
    <tbody>
      <% raport.cant.linii.forEach(function (c) { %>
        <tr>
          <td><b><%= c.mm %> mm</b></td>
          <td class="small"><%= c.decor %></td>
          <td class="num"><b><%= c.ml %></b> <%= t('comun.ml') %></td>
        </tr>
      <% }); %>
    </tbody>
    <tfoot><tr><td colspan="2"><b><%= t('comun.total') %></b></td>
      <td class="num"><b><%= raport.cant.total %> <%= t('comun.ml') %></b></td></tr></tfoot>
  </table></div>

  <div class="doua-coloane" style="margin-top:16px">
    <div>
      <h2><%= t('comanda.feronerieTitlu') %></h2>
      <p class="muted small" style="margin:0 0 6px">
        <%= t('fero.pentruSistem', { sistem: feroSistem.asamblare.nume }) %>
        <a href="?fero=1#feronerie"><%= t('fero.schimbaSistemul') %></a>
      </p>
      <div class="tbl"><table>
        <thead><tr><th><%= t('comun.articol') %></th><th class="num"><%= t('comun.cant') %></th>
          <th><%= t('comun.obs') %></th></tr></thead>
        <tbody>
          <% raport.feronerie.forEach(function (f) { %>
            <tr><td><%= f.nume %></td><td class="num"><b><%= f.qty %></b> <%= f.um %></td>
                <td class="muted small"><%= f.obs %></td></tr>
          <% }); %>
        </tbody>
      </table></div>
    </div>

    <div>
      <h2><%= t('comanda.prelucrari') %></h2>
      <% if (!raport.cnc.length) { %>
        <p class="muted small"><%= t('comanda.faraCnc') %></p>
      <% } else { %>
        <div class="tbl"><table>
          <thead><tr><th><%= t('comanda.colCorp') %></th><th><%= t('comanda.colPiesa') %></th>
            <th><%= t('comanda.colOperatie') %></th></tr></thead>
          <tbody>
            <% raport.cnc.forEach(function (x) { %>
              <tr><td class="small"><%= x.corp %></td><td class="small"><%= x.piesa %></td>
                  <td class="small"><%= x.tip %></td></tr>
            <% }); %>
          </tbody>
        </table></div>
        <p class="hint"><%- t('comanda.planseIn', { href: '/orders/' + order.id + '/print/cnc' }) %></p>
      <% } %>
    </div>
  </div>
</div>

<!-- ---------------- piesele ---------------- -->
<div class="panel">
  <div class="top" style="margin-bottom:8px">
    <h2 style="margin:0"><%= t('comanda.pieseDeDebitat', { n: raport.totaluri.bucati }) %></h2>
    <a class="btn small primary" href="/orders/<%= order.id %>/print/debitare"><%= t('comanda.deschideLista') %></a>
  </div>
  <div class="tbl"><table>
    <thead><tr>
      <th><%= t('comanda.colCod') %></th><th><%= t('comanda.colCorp') %></th>
      <th><%= t('comanda.colPiesa') %></th><th class="num"><%= t('comanda.colBuc') %></th>
      <th class="num"><%= t('comanda.colTaiereL') %></th><th class="num"><%= t('comanda.colTaierel') %></th>
      <th><%= t('comanda.colCantMuchii') %></th><th><%= t('comanda.colMaterial') %></th>
      <th><%= t('comanda.colFibra') %></th>
    </tr></thead>
    <tbody>
      <% raport.piese.forEach(function (p) { %>
        <tr>
          <td class="num"><%= p.cod %></td>
          <td class="small"><%= p.corpNume %></td>
          <td><%= p.nume %><% if (p.cnc) { %> <span class="chip cnc">CNC</span><% } %></td>
          <td class="num"><%= p.buc %></td>
          <td class="num"><b><%= p.TL %></b></td>
          <td class="num"><b><%= p.Tl %></b></td>
          <td class="small"><%= p.cant.special ? t('comanda.muchiiFrontale') : p.cant.muchii.join(' · ') %></td>
          <td class="small">
            <span class="decor-sw mic" style="background:<%= p.material.hex || '#cfd6dd' %>"></span>
            <%= p.material.tip %> <%= p.material.gros %>
          </td>
          <td class="small"><%= p.fibraText %></td>
        </tr>
      <% }); %>
    </tbody>
  </table></div>
</div>
<% } %>

<%# Ștergerea stătea pliată în „Setări comandă" și nimeni n-o găsea. Stă la
    vedere, dar singură jos și cu socoteala corpurilor în întrebare — nu lângă
    butoanele de zi cu zi. %>
<div class="panel zona-stergere">
  <div>
    <b><%= t('comanda.zonaStergere') %></b>
    <p class="muted small"><%= t('comanda.stergeExplica') %></p>
  </div>
  <form method="post" action="/orders/<%= order.id %>/delete">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn danger" type="submit"
            data-confirma="<%= t('comanda.confirmaStergereComanda', {
              nume: order.name,
              corpuri: t('comenzi.nrCorpuri', { n: raport.totaluri.corpuri })
            }) %>"><%= t('comanda.stergeComanda') %></button>
  </form>
</div>

<script type="application/json" id="page-data"><%- jsonPentruPagina({
  csrf: csrfToken,
  texte: {
    confirmaStergere: t('corpuri.confirmaStergere'),
    eroareStergere: t('corpuri.eroareStergere')
  }
}) %></script>
<script src="/static/corps-list.js?v=<%= assetV %>"></script>
<script src="/static/decor.js?v=<%= assetV %>"></script>
