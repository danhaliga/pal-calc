<% if (!raport.cnc.length) { %>
  <p class="doc-nota"><%= t('print.faraCncText') %></p>
<% } else { %>

<p class="doc-nota"><%- t('print.notaCnc') %></p>

<table class="doc-tbl">
  <thead><tr>
    <th><%= t('print.colCorp') %></th><th><%= t('print.colPiesa') %></th>
    <th class="num"><%= t('print.colBuc') %></th>
    <th class="num"><%= t('print.colGabarit') %></th>
    <th><%= t('print.colOperatie') %></th><th><%= t('print.colDetalii') %></th>
  </tr></thead>
  <tbody>
    <% raport.cnc.forEach(function (x) { %>
      <tr>
        <td><%= x.corp %></td>
        <td><%= x.piesa %></td>
        <td class="num"><%= x.buc %></td>
        <td class="num"><%= x.gabarit.L %> × <%= x.gabarit.l %></td>
        <td><b><%= x.tip %></b></td>
        <td class="small"><%= x.detalii %></td>
      </tr>
    <% }); %>
  </tbody>
</table>

<section class="doc-sect">
  <h2><%= t('print.planse') %></h2>
  <div class="cnc-grid">
    <% raport.cnc.filter(function (x) { return x.poly; }).forEach(function (x) { %>
      <figure class="cnc-card">
        <%- planse(x) %>
        <figcaption>
          <b><%= x.piesa %></b> — <%= x.corp %><br>
          <span class="muted"><%= t('print.planseGabarit', { n: x.buc, L: x.gabarit.L, l: x.gabarit.l }) %></span><br>
          <span class="small"><%= x.detalii %></span>
        </figcaption>
      </figure>
    <% }); %>
  </div>

  <% var nuturi = raport.cnc.filter(function (x) { return !x.poly; }); %>
  <% if (nuturi.length) { %>
    <h2><%= t('cnc.nutSpate') %></h2>
    <table class="doc-tbl">
      <thead><tr><th><%= t('print.colCorp') %></th><th><%= t('print.colPiesa') %></th>
        <th class="num"><%= t('print.colBuc') %></th><th><%= t('print.colDetalii') %></th></tr></thead>
      <tbody>
        <% nuturi.forEach(function (x) { %>
          <tr><td><%= x.corp %></td><td><%= x.piesa %></td><td class="num"><%= x.buc %></td>
              <td class="small"><%= x.detalii %></td></tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</section>

<% } %>

<%- include('../partials/fise-piese', { fiseCorpuri: fiseCorpuri }) %>
