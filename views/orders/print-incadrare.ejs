<p class="doc-nota">
  <%= t('print.notaIncadrare') %>
  <%- t('print.coliDeCumparat', { n: raport.totaluri.coli }) %>
</p>

<table class="doc-tbl">
  <thead><tr>
    <th><%= t('print.colMaterial') %></th><th class="num"><%= t('print.colPiese') %></th>
    <th><%= t('print.colColiFolosite') %></th>
    <th class="num"><%= t('print.colEchivalentColi') %></th>
    <th class="num"><%= t('print.colDeCumparat') %></th><th class="num"><%= t('print.colDeseu') %></th>
  </tr></thead>
  <tbody>
    <% raport.materiale.forEach(function (m) { %>
      <tr>
        <td><b><%= m.nume %></b></td>
        <td class="num"><%= m.bucati %></td>
        <td class="small"><%= m.bucatiColi.map(function (b) { return b.n + ' × ' + b.format.nume; }).join(' + ') %></td>
        <td class="num"><%= m.echivalent %></td>
        <td class="num"><b><%= m.coliIntregi %></b></td>
        <td class="num"><%= m.deseuPct %>%</td>
      </tr>
    <% }); %>
  </tbody>
</table>

<% raport.materiale.forEach(function (m) { %>
  <section class="doc-sect">
    <h2><%= t('print.antetColi', { nume: m.nume, coli: t('comanda.nColi', { n: m.bins.length }) }) %></h2>

    <% if (m.neplasate) { %>
      <div class="doc-warn"><%= t('print.neplasate', { n: m.neplasate }) %></div>
    <% } %>

    <div class="coli-grid">
      <% m.bins.forEach(function (bin, i) { %>
        <figure class="coala-card">
          <figcaption class="coala-cap">
            <b><%= t('print.coalaNr', { i: i + 1, total: m.bins.length }) %></b> — <%= bin.format.nume %>
            <span class="muted"><%= t('print.coalaRezumat', {
              piese: bin.placements.length,
              procent: Math.round(bin.fillPct),
              taieri: bin.cuts.length }) %></span>
          </figcaption>
          <%- planColi(bin, m) %>
          <figcaption class="coala-lista">
            <% var grupe = {};
               bin.placements.forEach(function (pl) {
                 var k = pl.piece.label + '|' + Math.round(pl.w) + '×' + Math.round(pl.h);
                 grupe[k] = (grupe[k] || 0) + 1;
               }); %>
            <%= Object.keys(grupe).map(function (k) {
                 var p = k.split('|');
                 return p[0] + ' (' + p[1] + ')' + (grupe[k] > 1 ? ' ×' + grupe[k] : '');
               }).join(' · ') %>
          </figcaption>
        </figure>
      <% }); %>
    </div>
  </section>
<% }); %>

<p class="doc-nota"><%= t('print.notaColi', { w: coala.w, h: coala.h }) %></p>
