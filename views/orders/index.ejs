<div class="top">
  <h1><%= t('comenzi.titlu') %></h1>
  <div class="btns" style="margin:0">
    <a class="btn" href="/credit"><%- t('comenzi.creditButon', { sold: (sold / 100).toFixed(2) }) %></a>
    <a class="btn primary" href="/orders/new"><%= t('comenzi.nouaButon') %></a>
  </div>
</div>

<% if (!comenzi.length) { %>
  <div class="panel empty">
    <p><%= t('comenzi.goalaTitlu') %></p>
    <p class="muted"><%= t('comenzi.goalaText') %></p>
    <div class="btns center"><a class="btn primary" href="/orders/new"><%= t('comenzi.goalaButon') %></a></div>
  </div>
<% } else { %>
  <div class="corp-list">
    <% comenzi.forEach(function (o) { %>
      <article class="corp-card">
        <a class="corp-main" href="/orders/<%= o.id %>">
          <h2><%= o.name %></h2>
          <div class="dims">
            <% (o.materiale || []).forEach(function (m) { %>
              <span class="decor-sw mic" title="<%= m.brand %> <%= m.decor_cod || '' %>"
                    style="background:<%= m.hex || '#cfd6dd' %>"></span>
            <% }); %>
            <%= (o.materiale || []).map(function (m) { return m.nume; }).join(' · ') || t('comenzi.faraMaterial') %>
            <%= o.nrMateriale > 3 ? ' +' + (o.nrMateriale - 3) : '' %>
          </div>
          <div class="meta">
            <%= t('comenzi.nrCorpuri', { n: o.nrCorpuri }) %> ·
            <%= t('comenzi.nrMateriale', { n: o.nrMateriale }) %> ·
            <%= t('comenzi.deschisaLa', { data: o.created_at.slice(0, 10) }) %>
          </div>
        </a>
        <div class="corp-side">
          <div class="btns">
            <a class="btn small" href="/orders/<%= o.id %>"><%= t('comenzi.deschide') %></a>
            <a class="btn small" href="/orders/<%= o.id %>/print/debitare"><%= t('comenzi.debitare') %></a>
          </div>
        </div>
      </article>
    <% }); %>
  </div>
<% } %>
