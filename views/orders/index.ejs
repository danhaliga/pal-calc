<div class="top">
  <h1>Comenzile mele</h1>
  <div class="btns" style="margin:0">
    <a class="btn" href="/credit">Credit: <b><%= (sold / 100).toFixed(2) %> lei</b></a>
    <a class="btn primary" href="/orders/new">+ Comandă nouă</a>
  </div>
</div>

<% if (!comenzi.length) { %>
  <div class="panel empty">
    <p>Nu ai încă nicio comandă.</p>
    <p class="muted">
      O comandă ține materialul (PAL-ul și cantul), corpurile și, la final, listele de dat
      la fabrică: debitare, montaj și CNC.
    </p>
    <div class="btns center"><a class="btn primary" href="/orders/new">Deschide prima comandă</a></div>
  </div>
<% } else { %>
  <div class="corp-list">
    <% comenzi.forEach(function (o) { %>
      <article class="corp-card">
        <a class="corp-main" href="/orders/<%= o.id %>">
          <h2><%= o.name %></h2>
          <div class="dims">
            <%= (brands.find(function (b) { return b.id === o.brand; }) || {}).nume || o.brand %>
            <%= o.decor ? '· ' + o.decor : '' %>
            · PAL <%= o.pal_mm %> mm · cant <%= o.cant_gros %>/<%= o.cant_subtire %> mm
          </div>
          <div class="meta"><%= o.nrCorpuri %> corpuri · deschisă <%= o.created_at.slice(0, 10) %></div>
        </a>
        <div class="corp-side">
          <div class="btns">
            <a class="btn small" href="/orders/<%= o.id %>">Deschide</a>
            <a class="btn small" href="/orders/<%= o.id %>/print/debitare">Debitare</a>
          </div>
        </div>
      </article>
    <% }); %>
  </div>
<% } %>
