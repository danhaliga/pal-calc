<div class="top">
  <h1><%= t('comandaNoua.titlu') %></h1>
  <a class="btn" href="/orders"><%= t('comun.inapoiLa') %></a>
</div>

<% if (error) { %><div class="warn err"><%= error %></div><% } %>

<div class="panel" style="max-width:820px">
  <p class="hint"><%= t('comandaNoua.intro') %></p>

  <form method="post" action="/orders">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <fieldset>
      <legend><%= t('comandaNoua.legComanda') %></legend>
      <div class="f">
        <label class="full"><%= t('comandaNoua.numeComanda') %>
          <input type="text" name="name" maxlength="80" required autofocus
                 placeholder="<%= t('comandaNoua.numeExemplu') %>" value="<%= values.name || '' %>">
        </label>
        <label class="full"><%= t('comandaNoua.observatiiOptional') %>
          <input type="text" name="note" maxlength="500" value="<%= values.note || '' %>">
        </label>
      </div>
      <p class="legend"><%= t('comandaNoua.dataAutomata') %></p>
      <div class="f3">
        <label><%= t('comanda.livrareLa') %>
          <input type="date" name="livrare_la" value="<%= values.livrare_la || '' %>">
        </label>
        <label><%= t('comanda.telefon') %>
          <input type="tel" name="telefon" maxlength="40" autocomplete="tel"
                 placeholder="<%= t('comanda.telefonExemplu') %>" value="<%= values.telefon || '' %>">
        </label>
      </div>
      <p class="legend"><%= t('comanda.livrareNota') %></p>
    </fieldset>

    <%# Un material E decor + grosime + cant, la un loc. De-aia cantul intra
        in fisa materialului: cu doua materiale pe pagina, o caseta de cant
        plutind intre ele n-ar mai spune al cui e. %>
    <fieldset>
      <legend><%= t('comandaNoua.legMaterialCarcase') %></legend>
      <div class="f3">
        <label><%= t('comandaNoua.producator') %>
          <select name="brand" id="brand">
            <% marci.forEach(function (m) { %>
              <option value="<%= m %>" <%= values.brand === m ? 'selected' : '' %>><%= m %></option>
            <% }); %>
          </select>
        </label>
        <label><%= t('comandaNoua.grosimePal') %>
          <select name="pal_mm" id="pal_mm">
            <% grosimi.forEach(function (g) { %>
              <option value="<%= g %>" <%= Number(values.pal_mm) === g ? 'selected' : '' %>><%= g %> mm</option>
            <% }); %>
          </select>
        </label>
      </div>
      <label style="margin-top:10px"><%= t('comandaNoua.decor') %>
        <%- include('../partials/decor-picker', { p: { camp: 'decor_cod',
              brandId: 'brand', palId: 'pal_mm',
              cantGrosId: 'cant_gros', cantSubtireId: 'cant_subtire', valoare: values.decor_cod } }) %>
      </label>
      <div class="f3" style="margin-top:10px">
        <label><%= t('comandaNoua.cantGros') %>
          <select name="cant_gros" id="cant_gros">
            <% cantStandard.forEach(function (c) { %>
              <option value="<%= c %>" <%= Number(values.cant_gros) === c ? 'selected' : '' %>><%= c %> mm</option>
            <% }); %>
          </select>
        </label>
        <label><%= t('comandaNoua.cantSubtire') %>
          <select name="cant_subtire" id="cant_subtire">
            <% cantStandard.forEach(function (c) { %>
              <option value="<%= c %>" <%= Number(values.cant_subtire) === c ? 'selected' : '' %>><%= c %> mm</option>
            <% }); %>
          </select>
        </label>
      </div>
      <p class="legend"><%= t('comandaNoua.notaCant') %></p>
    </fieldset>

    <%# Fronturile din alt decor. Bifa e INAINTEA blocului si in afara
        etichetei, nu inauntrul ei: asa o poate ajunge `~` din CSS si blocul
        se deschide fara o linie de JavaScript. Cu script ar fi trebuit un
        fisier nou si o gaura in politica de continut, pentru o casuta. %>
    <fieldset>
      <legend><%= t('comandaNoua.legMaterialFronturi') %></legend>
      <input type="checkbox" name="front_alt" id="front_alt" value="1"
             class="comutator" <%= values.front_alt ? 'checked' : '' %>>
      <label class="check" for="front_alt"><span><%= t('comandaNoua.frontAltDecor') %></span></label>
      <p class="legend"><%= t('comandaNoua.notaFrontAcelasi') %></p>
      <div class="doar-daca">
        <div class="f3" style="margin-top:10px">
          <label><%= t('comandaNoua.producator') %>
            <select name="brand_front" id="brand_front">
              <% marci.forEach(function (m) { %>
                <option value="<%= m %>" <%= (values.brand_front || values.brand) === m ? 'selected' : '' %>><%= m %></option>
              <% }); %>
            </select>
          </label>
          <label><%= t('comandaNoua.grosimePal') %>
            <select name="pal_mm_front" id="pal_mm_front">
              <% grosimi.forEach(function (g) { %>
                <option value="<%= g %>" <%= Number(values.pal_mm_front || values.pal_mm) === g ? 'selected' : '' %>><%= g %> mm</option>
              <% }); %>
            </select>
          </label>
        </div>
        <label style="margin-top:10px"><%= t('comandaNoua.decor') %>
          <%- include('../partials/decor-picker', { p: { camp: 'decor_cod_front',
                brandId: 'brand_front', palId: 'pal_mm_front',
                cantGrosId: 'cant_gros_front', cantSubtireId: 'cant_subtire_front',
                valoare: values.decor_cod_front } }) %>
        </label>
        <div class="f3" style="margin-top:10px">
          <label><%= t('comandaNoua.cantGros') %>
            <select name="cant_gros_front" id="cant_gros_front">
              <% cantStandard.forEach(function (c) { %>
                <option value="<%= c %>" <%= Number(values.cant_gros_front || values.cant_gros) === c ? 'selected' : '' %>><%= c %> mm</option>
              <% }); %>
            </select>
          </label>
          <label><%= t('comandaNoua.cantSubtire') %>
            <select name="cant_subtire_front" id="cant_subtire_front">
              <% cantStandard.forEach(function (c) { %>
                <option value="<%= c %>" <%= Number(values.cant_subtire_front || values.cant_subtire) === c ? 'selected' : '' %>><%= c %> mm</option>
              <% }); %>
            </select>
          </label>
        </div>
        <%# Cutiile de sertar sunt treaba de carcasa: se fac din decorul ei,
            si asa ramane daca nu zice nimeni altceva. Intrebarea are rost
            numai cand sunt doua decoruri, deci sta aici. %>
        <label style="margin-top:10px"><%= t('rol.sertar') %>
          <select name="sertare_din">
            <option value="corp" <%= values.sertare_din === 'front' ? '' : 'selected' %>><%= t('comandaNoua.cutiiDinCarcasa') %></option>
            <option value="front" <%= values.sertare_din === 'front' ? 'selected' : '' %>><%= t('comandaNoua.cutiiDinFronturi') %></option>
          </select>
        </label>
      </div>
    </fieldset>

    <%- include('../partials/feronerie-form', { f: feroOptiuni, ales: values }) %>

    <fieldset>
      <legend><%= t('comandaNoua.legFormate') %></legend>
      <div class="formate">
        <% formateId.forEach(function (id) { var f = formateToate[id]; %>
          <label class="check">
            <input type="checkbox" name="formate" value="<%= id %>"
                   <%= (values.formate || []).indexOf(id) !== -1 ? 'checked' : '' %>>
            <%= f.nume %> <span class="mono small"><%= f.w %> × <%= f.h %></span>
          </label>
        <% }); %>
      </div>
      <p class="legend"><%= t('comandaNoua.notaFormate') %></p>
    </fieldset>

    <button class="btn primary" type="submit"><%= t('comandaNoua.deschideComanda') %></button>
  </form>
</div>

<%# selectorul de decor scria românește direct în cod; acum își ia textele de aici %>
<script type="application/json" id="i18n"><%- jsonPentruPagina(catalogPagina(
  'comandaNoua', 'decor', 'comun'
)) %></script>
<script src="/static/decor.js?v=<%= assetV %>"></script>
