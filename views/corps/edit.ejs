<div class="top">
  <div class="crumbs">
    <% if (typeof order !== 'undefined' && order) { %>
      <a href="/orders/<%= order.id %>">← <%= order.name %></a>
    <% } else { %>
      <a href="/corps">← <%= t('editor.inapoiCorpuri') %></a>
    <% } %>
  </div>
  <div class="status-line">
    <span class="chip <%= corp.paid ? 'paid' : 'draft' %>"><%= corp.paid ? t('corpuri.chipPlatit') : t('corpuri.chipDraft') %></span>
    <span id="saveState" class="muted small"><%= t('editor.salvat') %></span>
  </div>
</div>

<% if (justPaid) { %>
  <div class="warn ok"><%= t('editor.platit') %></div>
<% } %>

<!-- conturul stă pe toată lățimea: tabelul cu laturi nu încape în coloana formularului -->
<div class="panel hidden" id="conturBox">
  <h2><%= t('editor.conturTitlu') %></h2>
  <p class="hint"><%= t('editor.conturHint') %></p>

  <div class="contur-lucru">
    <div>
      <div class="tbl">
        <table class="contur-tabel">
          <thead><tr>
            <th class="c">#</th><th><%= t('editor.colLatura') %></th>
            <th class="c"><%= t('editor.colLungimeMm') %></th>
            <th class="c"><%= t('editor.colUnghi') %></th><th></th>
          </tr></thead>
          <tbody id="conturTabel"></tbody>
        </table>
      </div>
      <div class="btns">
        <button type="button" class="btn small" id="conturAdauga"><%= t('editor.adaugaLatura') %></button>
        <button type="button" class="btn small" id="conturInchide"><%= t('editor.inchideConturul') %></button>
        <button type="button" class="btn small" id="conturReset"><%= t('editor.resetConturul') %></button>
      </div>
      <div id="conturStare" class="legend"></div>
    </div>
    <div class="contur-preview" id="conturPreview"></div>
  </div>
</div>

<div class="grid">

  <!-- ---------------- formular ---------------- -->
  <div class="panel">
    <h2><%= t('editor.corp') %></h2>
    <form id="form" autocomplete="off">
      <fieldset>
        <div class="f">
          <label class="full"><%= t('editor.denumire') %><input id="nume" type="text" maxlength="80"></label>
          <label class="full"><%= t('editor.tipCorp') %><select id="tip">
            <option value="drept"><%= t('editor.tipDrept') %></option>
            <option value="colt-orb"><%= t('editor.tipColtOrb') %></option>
            <option value="colt-L"><%= t('editor.tipColtL') %></option>
            <option value="colt-diagonal"><%= t('editor.tipColtDiagonal') %></option>
            <option value="atipic"><%= t('editor.tipAtipic') %></option>
          </select></label>
          <label><span id="labelW"><%= t('editor.latime') %></span><input id="W" type="number" min="100" max="3000" step="1"></label>
          <label><%= t('editor.inaltime') %><input id="H" type="number" min="100" max="3000" step="1"></label>
          <label><span id="labelD"><%= t('editor.adancime') %></span><input id="D" type="number" min="100" max="3000" step="1"></label>
          <label id="wrapW2"><%= t('editor.laturaPerete2') %><input id="W2" type="number" min="100" max="3000" step="1"></label>
          <label id="wrapOrb"><%= t('editor.latimeOarba') %><input id="orb" type="number" min="0" max="2000" step="1"></label>
          <label id="wrapConstr"><%= t('editor.constructie') %><select id="constr">
            <option value="intre"><%= t('editor.constrIntre') %></option>
            <option value="peste"><%= t('editor.constrPeste') %></option>
          </select></label>
        </div>
        <p class="legend hidden" id="notaColt"></p>
      </fieldset>

      <fieldset>
        <legend><%= t('editor.legMaterial') %></legend>
        <div class="f3">
          <label><%= t('editor.palMm') %><select id="t"><option>16</option><option>18</option><option>25</option></select></label>
          <label><%= t('editor.cantGros') %><input id="cg" type="number" step="0.1" min="0" max="5"></label>
          <label><%= t('editor.cantSubtire') %><input id="cs" type="number" step="0.1" min="0" max="5"></label>
        </div>
        <div class="f" style="margin-top:8px">
          <label><%= t('editor.spate') %><select id="spate">
            <option value="aplicat"><%= t('editor.spatePflAplicat') %></option>
            <option value="nut"><%= t('editor.spatePflNut') %></option>
            <option value="pal"><%= t('editor.spatePalNut') %></option>
          </select></label>
          <label><%= t('editor.grosimeSpate') %><input id="tp" type="number" step="0.5" min="0" max="50"></label>
        </div>
      </fieldset>

      <fieldset>
        <legend><%= t('editor.legUsi') %></legend>
        <div class="f3">
          <label><%= t('editor.numarUsi') %><select id="nUsi">
            <option>0</option><option>1</option><option>2</option><option>3</option><option>4</option>
          </select></label>
          <label><%= t('editor.montaj') %><select id="montaj">
            <option value="aplicat"><%= t('editor.montajAplicat') %></option>
            <option value="incastrat"><%= t('editor.montajIncastrat') %></option>
          </select></label>
          <label><%= t('editor.balama') %><select id="balama">
            <option value="0"><%= t('editor.balamaCot0') %></option>
            <option value="9"><%= t('editor.balamaCot9') %></option>
            <option value="18"><%= t('editor.balamaCot18') %></option>
          </select></label>
          <label><%= t('editor.rostMargine') %><input id="rm" type="number" step="0.5" min="0" max="50"></label>
          <label><%= t('editor.rostIntreFronturi') %><input id="ri" type="number" step="0.5" min="0" max="50"></label>
          <label><%= t('editor.rostIncastrat') %><input id="rinc" type="number" step="0.5" min="0" max="50"></label>
        </div>
      </fieldset>

      <fieldset>
        <legend><%= t('editor.legMontanti') %></legend>
        <div class="f3">
          <label><%= t('editor.numarMontanti') %><input id="nDsp" type="number" min="0" max="6" step="1"></label>
        </div>
      </fieldset>

      <fieldset>
        <legend><%= t('editor.legPolite') %></legend>
        <div class="f3">
          <label><%= t('editor.numarPolite') %><input id="nPol" type="number" min="0" max="20" step="1"></label>
          <label><%= t('editor.jocLateral') %><input id="jp" type="number" step="0.5" min="0" max="50"></label>
          <label><%= t('editor.retragereFata') %><input id="rp" type="number" step="1" min="0" max="300"></label>
        </div>
      </fieldset>

      <fieldset>
        <legend><%= t('editor.legSertare') %></legend>
        <div class="f3">
          <label><%= t('editor.numarSertare') %><input id="nSer" type="number" min="0" max="12" step="1"></label>
          <label><%= t('editor.inaltimeFront') %><input id="hFront" type="number" step="1" min="20" max="1200"></label>
          <label><%= t('editor.inaltimeCutie') %><input id="hCutie" type="number" step="1" min="20" max="1200"></label>
          <label><%= t('editor.jocGlisiera') %><input id="jg" type="number" step="0.5" min="0" max="50"></label>
          <label><%= t('editor.palCutie') %><select id="ts"><option>16</option><option>18</option></select></label>
          <label><%= t('editor.lungimeGlisiera') %><input id="lg" type="number" step="50" min="0" max="1200" placeholder="<%= t('editor.auto') %>"></label>
        </div>
      </fieldset>
    </form>
    <p class="legend"><%= t('editor.salvareAutomata') %></p>
  </div>

  <!-- ---------------- 3D + listă ---------------- -->
  <div>
    <div class="panel">
      <div class="top">
        <h2 style="margin:0" id="titlu3d"><%= t('editor.vedere3d') %></h2>
        <div class="btns" style="margin:0">
          <button class="btn small" data-view="iso"><%= t('editor.vedereIzo') %></button>
          <button class="btn small" data-view="fata"><%= t('editor.vedereFata') %></button>
          <button class="btn small" data-view="sus"><%= t('editor.vedereSus') %></button>
          <button class="btn small" data-view="spate"><%= t('editor.vedereSpate') %></button>
        </div>
      </div>
      <div class="bar3d">
        <label><%= t('editor.explodat') %> <input type="range" id="explode" min="0" max="100" value="0"></label>
        <label><input type="checkbox" id="auto"> <%= t('editor.rotireAutomata') %></label>
        <span class="grp">
          <label><input type="checkbox" class="vis" data-g="corp" checked> <%= t('editor.grupCorp') %></label>
          <label><input type="checkbox" class="vis" data-g="spate" checked> <%= t('editor.grupSpate') %></label>
          <label><input type="checkbox" class="vis" data-g="fronturi" checked> <%= t('editor.grupFronturi') %></label>
          <label><input type="checkbox" class="vis" data-g="sertare" checked> <%= t('editor.grupSertare') %></label>
          <label><input type="checkbox" class="vis" data-g="polite" checked> <%= t('editor.grupPolite') %></label>
        </span>
      </div>
      <div class="cvwrap" id="cvwrap"><canvas id="cv"></canvas></div>
      <div class="info" id="info"></div>
      <p class="legend">
        <span class="sw" style="background:#d9c7a8"></span><%= t('editor.legenda3dFataPal') %> ·
        <span class="sw" style="background:#d48a1e"></span><%= t('editor.legenda3dCantGros') %> ·
        <span class="sw" style="background:#f1cf93"></span><%= t('editor.legenda3dCantSubtire') %> ·
        <span class="sw" style="background:#b09572"></span><%= t('editor.legenda3dMuchieBruta') %> ·
        <span class="sw" style="background:#7a6650"></span><%= t('editor.legenda3dPfl') %>.
        <%= t('editor.legenda3dManuire') %>
      </p>
    </div>

    <div class="panel">
      <div class="top">
        <h2 style="margin:0" id="titlu"><%= t('editor.listaPiese') %></h2>
        <div class="btns" style="margin:0">
          <% if (corp.paid) { %>
            <button class="btn small" id="copyCorp"><%= t('editor.copiazaCsv') %></button>
            <a class="btn small" href="/corps/<%= corp.id %>/export.csv"><%= t('editor.descarcaCsv') %></a>
          <% } else { %>
            <button class="btn small" disabled title="<%= t('editor.dupaDeblocare') %>"><%= t('editor.copiazaCsv') %></button>
          <% } %>
        </div>
      </div>

      <div id="warns"></div>

      <% if (!corp.paid) { %>
        <div class="paywall">
          <div>
            <b><%= t('editor.blocatTitlu') %></b>
            <p class="muted small"><%= t('editor.blocatText') %></p>
          </div>
          <form method="post" action="/corps/<%= corp.id %>/pay">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn primary" type="submit"><%= t('editor.deblocheaza', { pret: priceLei }) %></button>
          </form>
        </div>
      <% } %>

      <div class="tbl"><table>
        <thead><tr>
          <th><%= t('editor.colPiesa') %></th><th class="num"><%= t('editor.colBuc') %></th>
          <th class="num"><%= t('editor.colFinitL') %></th><th class="num"><%= t('editor.colFinitl') %></th>
          <th class="<%= corp.paid ? '' : 'locked-h' %>"><%= t('editor.colCantMuchii') %></th>
          <th class="num <%= corp.paid ? '' : 'locked-h' %>"><%= t('editor.colTaiereL') %></th>
          <th class="num <%= corp.paid ? '' : 'locked-h' %>"><%= t('editor.colTaierel') %></th>
          <th><%= t('editor.colFibra') %></th>
        </tr></thead>
        <tbody id="rows"></tbody>
      </table></div>

      <p class="legend">
        <span class="cant"><span class="g">2</span></span>
        <span class="cant"><span class="s">0.4</span></span>
        <span class="cant"><span>–</span></span>
        <%= t('editor.legendaCant') %>
      </p>

      <details>
        <summary><%= t('editor.formuleTitlu') %></summary>
        <div class="formule" id="formule"></div>
      </details>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script type="application/json" id="i18n"><%- jsonPentruPagina(catalogPagina(
  'editor', 'piesa', 'nota', 'avert', 'fibra', 'directie', 'fata', 'csv', 'comun', 'modele'
)) %></script>
<script type="application/json" id="page-data"><%- jsonPentruPagina({
  corpId: corp.id,
  params: corp.params,
  paid: corp.paid,
  csrf: csrfToken,
  priceLei: priceLei
}) %></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="/shared/calc.js?v=<%= assetV %>"></script>
<script src="/static/app.js?v=<%= assetV %>"></script>
