<div class="top">
  <div class="crumbs">
    <% if (typeof order !== 'undefined' && order) { %>
      <a href="/orders/<%= order.id %>">← <%= order.name %></a>
    <% } else { %>
      <a href="/corps">← <%= t('editor.inapoiCorpuri') %></a>
    <% } %>
  </div>
  <div class="status-line">
    <span class="chip <%= corp.paid ? 'paid' : 'draft' %>"><%= corp.paid ? t('corpuri.chipPlatit') : t('corpuri.chipDraft') %></span>
    <span id="saveState" class="muted small"><%= t('editor.salvat') %></span>
  </div>
</div>

<% if (justPaid) { %>
  <div class="warn ok"><%= t('editor.platit') %></div>
<% } %>

<!-- conturul stă pe toată lățimea: tabelul cu laturi nu încape în coloana formularului -->
<%# Conturul corpului atipic.

    Cotele stau primele si tabelul de laturi sta strans, nu invers. Cine face
    un corp sub scara are sub ochi latimea de jos si cele doua inaltimi — nu
    panta si unghiurile ei, alea se socotesc. Tabelul ramane insa: corpul de
    mansarda are cinci laturi si nu se poate scrie din trei cote, iar „atipic
    liber" tocmai asta e — forma facuta de mana. %>
<div class="panel hidden" id="conturBox">
  <h2><%= t('editor.conturTitlu') %></h2>

  <div class="contur-lucru">
    <div>
      <fieldset class="sub-scara">
        <legend><%= t('editor.subScaraTitlu') %></legend>
        <div class="f3">
          <label><%= t('editor.subScaraBaza') %>
            <input id="ssBaza" type="number" step="10" min="10" max="4000"></label>
          <label><%= t('editor.subScaraStanga') %>
            <input id="ssStanga" type="number" step="10" min="10" max="4000"></label>
          <label><%= t('editor.subScaraDreapta') %>
            <input id="ssDreapta" type="number" step="10" min="10" max="4000"></label>
        </div>
        <button type="button" class="btn small primary" id="ssFa" style="margin-top:10px"><%= t('editor.subScaraFa') %></button>
        <p class="legend"><%= t('editor.subScaraNota') %></p>
      </fieldset>

      <div id="conturStare" class="legend"></div>

      <details class="contur-manual" id="conturManual">
        <summary><%= t('editor.conturDeMana') %></summary>
        <p class="hint"><%= t('editor.conturHint') %></p>
        <div class="tbl">
          <table class="contur-tabel">
            <thead><tr>
              <th class="c">#</th><th><%= t('editor.colLatura') %></th>
              <th class="c"><%= t('editor.colLungimeMm') %></th>
              <th class="c"><%= t('editor.colUnghi') %></th><th></th>
            </tr></thead>
            <tbody id="conturTabel"></tbody>
          </table>
        </div>
        <div class="btns">
          <button type="button" class="btn small" id="conturAdauga"><%= t('editor.adaugaLatura') %></button>
          <button type="button" class="btn small" id="conturInchide"><%= t('editor.inchideConturul') %></button>
          <button type="button" class="btn small" id="conturReset"><%= t('editor.resetConturul') %></button>
        </div>
      </details>
    </div>
    <div class="contur-preview" id="conturPreview"></div>
  </div>
</div>

<div class="grid">

  <!-- ---------------- formular ---------------- -->
  <div class="panel">
    <h2><%= t('editor.corp') %></h2>
    <form id="form" autocomplete="off">
      <fieldset>
        <div class="f">
          <label class="full"><%= t('editor.denumire') %><input id="nume" type="text" maxlength="80"></label>
          <label class="full"><%= t('editor.tipCorp') %><select id="tip">
            <option value="drept"><%= t('editor.tipDrept') %></option>
            <option value="colt-orb"><%= t('editor.tipColtOrb') %></option>
            <option value="colt-L"><%= t('editor.tipColtL') %></option>
            <option value="colt-diagonal"><%= t('editor.tipColtDiagonal') %></option>
            <option value="atipic"><%= t('editor.tipAtipic') %></option>
            <option value="piesa"><%= t('editor.tipPiesa') %></option>
          </select></label>
          <label><span id="labelW"><%= t('editor.latime') %></span><input id="W" type="number" min="20" max="3000" step="1"></label>
          <label><span id="labelH"><%= t('editor.inaltime') %></span><input id="H" type="number" min="20" max="3000" step="1"></label>
          <label><span id="labelD"><%= t('editor.adancime') %></span><input id="D" type="number" min="100" max="3000" step="1"></label>
          <label id="wrapW2"><%= t('editor.laturaPerete2') %><input id="W2" type="number" min="100" max="3000" step="1"></label>
          <label id="wrapOrb"><%= t('editor.latimeOarba') %><input id="orb" type="number" min="0" max="2000" step="1"></label>
          <label id="wrapConstr"><%= t('editor.constructie') %><select id="constr">
            <option value="intre"><%= t('editor.constrIntre') %></option>
            <option value="peste"><%= t('editor.constrPeste') %></option>
          </select></label>
          <%# Soclul: corpul sta pe podea, fara picioare. Zero inseamna
              picioare — alea sunt feronerie, nu se taie din PAL. %>
          <label><%= t('editor.soclu') %>
            <input id="soclu" type="number" step="5" min="0" max="300"></label>
          <%# Picioarele: corpul de bucatarie pus in sir sta pe picioare de
              plastic, cu plinta de aluminiu clipsata in fata. Nu se taie
              nimic: picioarele si plinta intra la feronerie, pe comanda.
              Cu soclu pus, soclul castiga. %>
          <label><%= t('editor.picioare') %><select id="picioare">
            <option value="0"><%= t('editor.picioareNu') %></option>
            <option value="1"><%= t('editor.picioareDa') %></option>
          </select></label>
          <%# Traversele: in locul blatului intreg, doua fasii, una in fata
              si una in spate. Sub blatul de bucatarie un panou pe toata
              adancimea e PAL aruncat — il acopera blatul oricum. %>
          <label><%= t('editor.traverse') %>
            <input id="traverse" type="number" step="5" min="0" max="100"
                   placeholder="<%= t('editor.traverseFara') %>"></label>
        </div>
        <p class="legend hidden" id="notaColt"></p>
      </fieldset>

      <%# Piesa simplă: un singur panou, cu cantul lui pe fiecare muchie.
          Se vede doar la tipul „piesă"; restul fieldset-urilor se ascund. %>
      <fieldset id="fsPiesa" class="hidden">
        <legend><%= t('editor.legPiesa') %></legend>
        <div class="f3">
          <label><%= t('editor.bucati') %><input id="pBuc" type="number" min="1" max="999" step="1"></label>
          <label><%= t('editor.fibraPiesa') %><select id="pFibra">
            <option value="L"><%= t('editor.fibraPeLungime') %></option>
            <option value="l"><%= t('editor.fibraPeLatime') %></option>
            <option value="-"><%= t('editor.fibraOricum') %></option>
          </select></label>
        </div>
        <p class="legend"><%= t('editor.notaMuchiiPiesa') %></p>
        <div class="f3">
          <%# Cheile sunt scrise pe litere, nu „L1"/„l1": două chei care
              se deosebesc doar prin literă mare/mică sunt o capcană. %>
          <% [['pcL1','muchieLunga1'], ['pcL2','muchieLunga2'],
              ['pcl1','muchieScurta1'], ['pcl2','muchieScurta2']].forEach(function (par) {
               var id = par[0]; %>
            <label><%= t('editor.' + par[1]) %><select id="<%= id %>">
              <option value="-"><%= t('editor.faraCant') %></option>
              <option value="g"><%= t('editor.cantGrosOpt') %></option>
              <option value="s"><%= t('editor.cantSubtireOpt') %></option>
            </select></label>
          <% }); %>
        </div>
      </fieldset>

      <fieldset id="fsMaterial">
        <legend><%= t('editor.legMaterial') %></legend>
        <div class="f3">
          <label><%= t('editor.palMm') %><select id="t"><option>16</option><option>18</option><option>25</option></select></label>
          <label><%= t('editor.cantGros') %><input id="cg" type="number" step="0.1" min="0" max="5"></label>
          <label><%= t('editor.cantSubtire') %><input id="cs" type="number" step="0.1" min="0" max="5"></label>
        </div>
        <%# Spatele e al corpului, nu al unei piese răzlețe. %>
        <div class="f" style="margin-top:8px" id="randSpate">
          <label><%= t('editor.spate') %><select id="spate">
            <option value="aplicat"><%= t('editor.spatePflAplicat') %></option>
            <option value="nut"><%= t('editor.spatePflNut') %></option>
            <option value="pal"><%= t('editor.spatePalNut') %></option>
          </select></label>
          <label><%= t('editor.grosimeSpate') %><input id="tp" type="number" step="0.5" min="0" max="50"></label>
        </div>
      </fieldset>

      <fieldset id="fsUsi">
        <legend><%= t('editor.legUsi') %></legend>
        <div class="f3">
          <%# Fronturile se pot lasa afara cu totul: se comanda doar corpul,
              iar usile le pune omul de la el. Sta PRIMUL in grupa usilor,
              nu la coada: hotaraste ce se intampla cu tot ce vine dupa. %>
          <label><%= t('editor.fronturi') %><select id="faraFront">
            <option value="0"><%= t('editor.fronturiSeFac') %></option>
            <option value="1"><%= t('editor.fronturiNuSeFac') %></option>
          </select></label>
          <label><%= t('editor.numarUsi') %><select id="nUsi">
            <option>0</option><option>1</option><option>2</option><option>3</option><option>4</option>
          </select></label>
          <%# Înălțimea stă lângă număr, nu la coada rosturilor: cine caută
              „ușă doar pe jumătate de corp" se uită întâi aici. %>
          <label><%= t('editor.inaltimeUsi') %><input id="hUsi" type="number" step="10" min="0" max="3000"
                 placeholder="<%= t('editor.hUsiToata') %>"></label>
          <%# Nisa: golul dintre zonele cu usi. Cu inaltimea usilor de jos
              pusa, golul vine deasupra lor — coloana de cuptor. Fara ea,
              golul incepe de la fund — coloana de frigider. %>
          <label><%= t('editor.nisa') %><input id="hNisa" type="number" step="10" min="0" max="3000"
                 placeholder="<%= t('editor.nisaFara') %>"></label>
          <label><%= t('editor.montaj') %><select id="montaj">
            <option value="aplicat"><%= t('editor.montajAplicat') %></option>
            <option value="incastrat"><%= t('editor.montajIncastrat') %></option>
            <option value="glisant"><%= t('editor.montajGlisant') %></option>
          </select></label>
          <%# Numai pentru usi glisante: alea se suprapun si merg pe sine. %>
          <label id="wrapSupr" class="hidden"><%= t('editor.suprapunere') %>
            <input id="supr" type="number" step="5" min="0" max="200"></label>
          <label id="wrapSine" class="hidden"><%= t('editor.hSine') %>
            <input id="hSine" type="number" step="5" min="0" max="300"></label>
          <label><%= t('editor.balama') %><select id="balama">
            <option value="0"><%= t('editor.balamaCot0') %></option>
            <option value="9"><%= t('editor.balamaCot9') %></option>
            <option value="18"><%= t('editor.balamaCot18') %></option>
          </select></label>
          <label><%= t('editor.rostMargine') %><input id="rm" type="number" step="0.5" min="0" max="50"></label>
          <label><%= t('editor.rostIntreFronturi') %><input id="ri" type="number" step="0.5" min="0" max="50"></label>
          <label><%= t('editor.rostIncastrat') %><input id="rinc" type="number" step="0.5" min="0" max="50"></label>
        </div>
        <%# Bifele apar doar când există montant: fără el corpul are un singur
            compartiment și n-ai ce alege. Le desenează app.js. %>
        <div id="compUsiBox" class="hidden" style="margin-top:10px">
          <span class="camp-eticheta"><%= t('editor.usiPeCompartimente') %></span>
          <div class="setari-grupe orizontal" id="compUsiLista"></div>
        </div>
        <p class="legend"><%= t('editor.notaInaltimeUsi') %></p>
      </fieldset>

      <fieldset id="fsMontanti">
        <legend><%= t('editor.legMontanti') %></legend>
        <div class="f3">
          <label><%= t('editor.numarMontanti') %><input id="nDsp" type="number" min="0" max="6" step="1"></label>
        </div>
      </fieldset>

      <fieldset id="fsPolite">
        <legend><%= t('editor.legPolite') %></legend>
        <div class="f3">
          <label><%= t('editor.numarPolite') %><input id="nPol" type="number" min="0" max="20" step="1"></label>
          <label><%= t('editor.jocLateral') %><input id="jp" type="number" step="0.5" min="0" max="50"></label>
          <label><%= t('editor.retragereFata') %><input id="rp" type="number" step="1" min="0" max="300"></label>
        </div>
      </fieldset>

      <fieldset id="fsSertare">
        <legend><%= t('editor.legSertare') %></legend>
        <div class="f3">
          <label><%= t('editor.numarSertare') %><input id="nSer" type="number" min="0" max="12" step="1"></label>
          <%# Unde stau: sus, ca pana acum, sau jos cu usile deasupra —
              corpul de cuptor cu sertar dedesubt. Sta langa numar, fiindca
              e a doua intrebare pe care si-o pune omul dupa „cate". %>
          <label><%= t('editor.pozitieSertare') %><select id="sertareJos">
            <option value="0"><%= t('editor.sertareSus') %></option>
            <option value="1"><%= t('editor.sertareJos') %></option>
          </select></label>
          <label><%= t('editor.inaltimeFront') %><input id="hFront" type="number" step="1" min="20" max="1200"></label>
          <label><%= t('editor.inaltimeCutie') %><input id="hCutie" type="number" step="1" min="20" max="1200"></label>
          <label><%= t('editor.jocGlisiera') %><input id="jg" type="number" step="0.5" min="0" max="50"></label>
          <label><%= t('editor.palCutie') %><select id="ts"><option>16</option><option>18</option></select></label>
          <label><%= t('editor.lungimeGlisiera') %><input id="lg" type="number" step="50" min="0" max="1200" placeholder="<%= t('editor.auto') %>"></label>
        </div>
      </fieldset>

      <%# Manerul sta in grupa lui, nu la usi: e si al sertarelor. Bifa
          intai, ca de ea atarna restul. %>
      <fieldset id="fsManer">
        <legend><%= t('editor.legManer') %></legend>
        <label class="check"><input id="maner" type="checkbox">
          <span><%= t('editor.sePuneManer') %></span></label>
        <p class="legend"><%= t('editor.notaManer') %></p>
        <div class="f3" id="randManer">
          <label><%= t('editor.manerCum') %><select id="manerDir">
            <option value="obisnuit"><%= t('editor.manerObisnuit') %></option>
            <option value="orizontal"><%= t('editor.manerOrizontal') %></option>
            <option value="vertical"><%= t('editor.manerVertical') %></option>
          </select></label>
          <%# Gol inseamna „cat incape": manerul se deseneaza pe o treime din
              latura frontului, ca inainte de a exista caseta asta. %>
          <label><%= t('editor.manerLungime') %>
            <input id="manerL" type="number" step="8" min="0" max="1200"
                   placeholder="<%= t('editor.manerCatIncape') %>"></label>
          <label><%= t('editor.manerUnde') %><select id="manerPoz">
            <option value="obisnuit"><%= t('editor.manerObisnuit') %></option>
            <option value="centru"><%= t('editor.manerCentru') %></option>
            <option value="stanga"><%= t('editor.manerStanga') %></option>
            <option value="dreapta"><%= t('editor.manerDreapta') %></option>
            <option value="sus"><%= t('editor.manerSus') %></option>
            <option value="jos"><%= t('editor.manerJos') %></option>
          </select></label>
        </div>
      </fieldset>
    </form>
    <p class="legend"><%= t('editor.salvareAutomata') %></p>

    <%# Setările stau în browser, nu în bază — vezi comentariul din app.js. %>
    <details class="setari" id="setariBox">
      <summary><%= t('setari.titlu') %></summary>
      <p class="hint"><%= t('setari.explica') %></p>
      <div class="setari-grupe" id="setariGrupe"></div>
      <p class="legend"><%= t('setari.notaModel') %></p>
      <div class="btns">
        <button type="button" class="btn small primary" id="setariIa"><%= t('setari.iaDinCorp') %></button>
        <button type="button" class="btn small" id="setariSterge"><%= t('setari.sterge') %></button>
      </div>
      <p class="legend" id="setariStare"></p>
    </details>
  </div>

  <!-- ---------------- 3D + listă ----------------
       Amandoua sunt copii DIRECTI ai grilei, nu invelite intr-un div: asa
       se pot aseza altfel pe ecran ingust (corpul primul, formularul dupa)
       fara `display:contents`, care se bate cu flexbox pe latime. -->
    <div class="panel">
      <div class="top">
        <h2 style="margin:0" id="titlu3d"><%= t('editor.vedere3d') %></h2>
        <div class="btns" style="margin:0">
          <button class="btn small" data-view="iso"><%= t('editor.vedereIzo') %></button>
          <button class="btn small" data-view="fata"><%= t('editor.vedereFata') %></button>
          <button class="btn small" data-view="sus"><%= t('editor.vedereSus') %></button>
          <button class="btn small" data-view="spate"><%= t('editor.vedereSpate') %></button>
        </div>
      </div>
      <div class="bar3d">
        <label><%= t('editor.explodat') %> <input type="range" id="explode" min="0" max="100" value="0"></label>
        <label><input type="checkbox" id="auto"> <%= t('editor.rotireAutomata') %></label>
        <span class="grp">
          <label><input type="checkbox" class="vis" data-g="corp" checked> <%= t('editor.grupCorp') %></label>
          <label><input type="checkbox" class="vis" data-g="spate" checked> <%= t('editor.grupSpate') %></label>
          <label><input type="checkbox" class="vis" data-g="fronturi" checked> <%= t('editor.grupFronturi') %></label>
          <label><input type="checkbox" class="vis" data-g="sertare" checked> <%= t('editor.grupSertare') %></label>
          <label><input type="checkbox" class="vis" data-g="polite" checked> <%= t('editor.grupPolite') %></label>
          <label><input type="checkbox" class="vis" data-g="manere" checked> <%= t('editor.grupManere') %></label>
        </span>
      </div>
      <%# Etichetele cu numere stau peste canvas, nu in el: text HTML
          adevarat, care ramane citet la orice marime, spre deosebire de
          text desenat in textura. %>
      <div class="cvwrap" id="cvwrap">
        <canvas id="cv"></canvas>
        <div class="etichete3d" id="etichete3d" aria-hidden="true"></div>
      </div>
      <div class="info" id="info"></div>
      <p class="legend">
        <span class="sw" style="background:#d9c7a8"></span><%= t('editor.legenda3dFataPal') %> ·
        <span class="sw" style="background:#d48a1e"></span><%= t('editor.legenda3dCantGros') %> ·
        <span class="sw" style="background:#f1cf93"></span><%= t('editor.legenda3dCantSubtire') %> ·
        <span class="sw" style="background:#b09572"></span><%= t('editor.legenda3dMuchieBruta') %> ·
        <span class="sw" style="background:#7a6650"></span><%= t('editor.legenda3dPfl') %>.
        <%= t('editor.legenda3dManuire') %>
      </p>
    </div>

    <div class="panel">
      <div class="top">
        <h2 style="margin:0" id="titlu"><%= t('editor.listaPiese') %></h2>
        <div class="btns" style="margin:0">
          <% if (corp.paid) { %>
            <button class="btn small" id="copyCorp"><%= t('editor.copiazaCsv') %></button>
            <a class="btn small" href="/corps/<%= corp.id %>/export.csv"><%= t('editor.descarcaCsv') %></a>
          <% } else { %>
            <button class="btn small" disabled title="<%= t('editor.dupaDeblocare') %>"><%= t('editor.copiazaCsv') %></button>
          <% } %>
        </div>
      </div>

      <div id="warns"></div>

      <% if (!corp.paid) { %>
        <div class="paywall">
          <div>
            <b><%= t('editor.blocatTitlu') %></b>
            <p class="muted small"><%= t('editor.blocatText') %></p>
          </div>
          <form method="post" action="/corps/<%= corp.id %>/pay">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn primary" type="submit"><%= t('editor.deblocheaza', { pret: priceLei }) %></button>
          </form>
        </div>
      <% } %>

      <div class="tbl"><table>
        <thead><tr>
          <th class="c">#</th>
          <th><%= t('editor.colPiesa') %></th><th class="num"><%= t('editor.colBuc') %></th>
          <th class="num"><%= t('editor.colFinitL') %></th><th class="num"><%= t('editor.colFinitl') %></th>
          <th class="<%= corp.paid ? '' : 'locked-h' %>"><%= t('editor.colCantMuchii') %></th>
          <th class="num <%= corp.paid ? '' : 'locked-h' %>"><%= t('editor.colTaiereL') %></th>
          <th class="num <%= corp.paid ? '' : 'locked-h' %>"><%= t('editor.colTaierel') %></th>
          <th><%= t('editor.colFibra') %></th>
        </tr></thead>
        <tbody id="rows"></tbody>
      </table></div>

      <p class="legend">
        <span class="cant"><span class="g">2</span></span>
        <span class="cant"><span class="s">0.4</span></span>
        <span class="cant"><span>–</span></span>
        <%= t('editor.legendaCant') %>
      </p>

      <details>
        <summary><%= t('editor.formuleTitlu') %></summary>
        <div class="formule" id="formule"></div>
      </details>
    </div>
</div>

<div class="toast" id="toast"></div>

<script type="application/json" id="i18n"><%- jsonPentruPagina(catalogPagina(
  'editor', 'setari', 'piesa', 'nota', 'avert', 'fibra', 'directie', 'fata', 'csv', 'comun', 'modele'
)) %></script>
<script type="application/json" id="page-data"><%- jsonPentruPagina({
  corpId: corp.id,
  params: corp.params,
  paid: corp.paid,
  csrf: csrfToken,
  priceLei: priceLei,
  nou: nou,
  matFixat: matFixat,
  cheiModel: cheiModel,
  pePodea: pePodea
}) %></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="/shared/calc.js?v=<%= assetV %>"></script>
<script src="/static/app.js?v=<%= assetV %>"></script>
