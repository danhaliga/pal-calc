<% var inComanda = (typeof order !== 'undefined' && order);
   var actiune = inComanda ? '/orders/' + order.id + '/corps' : '/corps'; %>

<div class="top">
  <div>
    <div class="crumbs">
      <a href="<%= inComanda ? '/orders/' + order.id : '/corps' %>">← <%= inComanda ? order.name : t('modele.inapoiCorpuri') %></a>
    </div>
    <h1><%= t('modele.titlu') %></h1>
    <p class="sub">
      <%= t('modele.intro') %>
      <% if (inComanda) { %>
        <%= t('modele.materialDinComanda', { pal: order.pal_mm, gros: order.cant_gros, subtire: order.cant_subtire }) %>
      <% } %>
    </p>
  </div>
  <% if (typeof pretCorp !== 'undefined') { %>
    <div class="cost-card">
      <div class="l"><%= t('modele.unCorpCosta') %></div>
      <div class="v"><%= (pretCorp / 100).toFixed(2) %> <%= t('comun.lei') %></div>
      <div class="muted small"><%= t('modele.creditul', { sold: (sold / 100).toFixed(2) }) %></div>
    </div>
  <% } %>
</div>

<% if (typeof sold !== 'undefined' && sold < pretCorp) { %>
  <div class="warn err"><%- t('modele.faraCredit') %></div>
<% } %>

<div class="filtre" id="filtre">
  <button class="btn small on" data-cat="toate" type="button"><%= t('modele.toate') %></button>
  <% categories.forEach(function (c) { %>
    <button class="btn small" data-cat="<%= c.id %>" type="button"><%= c.nume %></button>
  <% }); %>
</div>

<% categories.forEach(function (c) { %>
  <section class="grup" data-cat="<%= c.id %>">
    <h2><%= c.nume %></h2>
    <p class="hint"><%= c.descriere %></p>
    <div class="model-grid">
      <% models.filter(function (m) { return m.cat === c.id; }).forEach(function (m) { %>
        <form method="post" action="<%= actiune %>" class="model-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="model" value="<%= m.id %>">
          <button class="model-card" type="submit" title="<%= t('modele.creeazaDupaModel') %>">
            <span class="sk-wrap"><%- m.sketch %></span>
            <span class="model-body">
              <span class="model-nume"><%= m.nume %></span>
              <span class="model-dim"><%= m.params.W %> × <%= m.params.H %> × <%= m.params.D %> mm</span>
              <span class="model-rez"><%= m.rezumat %></span>
              <span class="model-desc"><%= m.descriere %></span>
            </span>
          </button>
        </form>
      <% }); %>
    </div>
  </section>
<% }); %>

<section class="grup" data-cat="gol">
  <h2><%= t('modele.faraModel') %></h2>
  <div class="model-grid">
    <form method="post" action="<%= actiune %>" class="model-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="model-card gol" type="submit">
        <span class="model-body">
          <span class="model-nume"><%= t('modele.corpGol') %></span>
          <span class="model-dim">800 × 720 × 560 mm</span>
          <span class="model-rez"><%= t('modele.valoriImplicite') %></span>
          <span class="model-desc"><%= t('modele.corpGolDesc') %></span>
        </span>
      </button>
    </form>

    <%# Piesa simplă stă lângă corpul gol, nu între modele: nu e un corp de
        bucătărie, e un singur panou cu cotele și cantul lui. %>
    <form method="post" action="<%= actiune %>" class="model-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="model" value="piesa-simpla">
      <button class="model-card gol" type="submit">
        <span class="model-body">
          <span class="model-nume"><%= t('modele.m.piesa-simpla.nume') %></span>
          <span class="model-dim">1200 × 600 mm</span>
          <span class="model-rez"><%= t('modele.m.piesa-simpla.rezumat') %></span>
          <span class="model-desc"><%= t('modele.m.piesa-simpla.descriere') %></span>
        </span>
      </button>
    </form>
  </div>
</section>

<div class="panel">
  <h2><%= t('modele.limiteTitlu') %></h2>
  <ul class="ticks">
    <li><%- t('modele.limita1') %></li>
    <li><%- t('modele.limita2') %></li>
    <li><%- t('modele.limita3') %></li>
    <li><%- t('modele.limita4') %></li>
    <li><%- t('modele.limita5') %></li>
    <li><%- t('modele.limita6') %></li>
  </ul>
  <p class="hint"><%= t('modele.limiteNota') %></p>

  <%# „Spune-mi care" cerea un loc unde să spui. Ăsta e. %>
  <% if (typeof mesajTrimis !== 'undefined' && mesajTrimis) { %>
    <div class="warn ok"><%= t('mesaj.multumim') %></div>
  <% } %>
  <form method="post" action="/mesaje" class="mesaj-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="pagina" value="modele">
    <input type="hidden" name="inapoi" value="<%= typeof order !== 'undefined' && order ? '/orders/' + order.id + '/corp-nou' : '/corps/new' %>">
    <label><%= t('mesaj.intrebare') %>
      <textarea name="text" rows="3" maxlength="2000" required
                placeholder="<%= t('mesaj.exemplu') %>"></textarea>
    </label>
    <button class="btn primary" type="submit"><%= t('mesaj.trimite') %></button>
  </form>
</div>

<script src="/static/models-pick.js?v=<%= assetV %>"></script>
