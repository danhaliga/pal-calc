<div class="top">
  <h1><%= t('corpuri.titlu') %></h1>
  <a class="btn primary" href="/corps/new"><%= t('corpuri.corpNou') %></a>
</div>

<% if (justPaid) { %>
  <div class="warn ok"><%= t('corpuri.platit') %></div>
<% } %>

<% if (!corps.length) { %>
  <div class="panel empty">
    <p><%= t('corpuri.goalaTitlu') %></p>
    <p class="muted"><%= t('corpuri.goalaText') %></p>
    <div class="btns center"><a class="btn primary" href="/corps/new"><%= t('corpuri.goalaButon') %></a></div>
  </div>
<% } else { %>
  <div class="corp-list">
    <% corps.forEach(function (c) { %>
      <article class="corp-card">
        <a class="corp-main" href="/corps/<%= c.id %>">
          <h2><%= c.name %></h2>
          <div class="dims"><%= c.params.W %> × <%= c.params.H %> × <%= c.params.D %> mm</div>
          <div class="meta">
            PAL <%= c.params.t %> ·
            <%= t('corpuri.metaUsi', { n: +c.params.nUsi }) %> ·
            <%= t('corpuri.metaPolite', { n: +c.params.nPol }) %> ·
            <%= t('corpuri.metaSertare', { n: +c.params.nSer }) %>
          </div>
        </a>
        <div class="corp-side">
          <span class="chip <%= c.paid ? 'paid' : 'draft' %>"><%= c.paid ? t('corpuri.chipPlatit') : t('corpuri.chipDraft') %></span>
          <span class="muted small"><%= t('corpuri.modificatLa', { data: c.updated_at.replace('T', ' ').slice(0, 16) }) %></span>
          <div class="btns">
            <a class="btn small" href="/corps/<%= c.id %>"><%= t('corpuri.deschide') %></a>
            <form method="post" action="/corps/<%= c.id %>/duplicate" class="inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn small" type="submit"
                      title="<%= t('corpuri.duplicaTitlu') %>"><%= t('corpuri.duplica', { pret: priceLei }) %></button>
            </form>
            <button class="btn small danger" data-delete="<%= c.id %>" data-name="<%= c.name %>"><%= t('corpuri.sterge') %></button>
          </div>
        </div>
      </article>
    <% }); %>
  </div>
  <p class="muted small"><%= t('corpuri.notaPret', { pret: priceLei }) %></p>
<% } %>

<script type="application/json" id="page-data"><%- jsonPentruPagina({
  csrf: csrfToken,
  texte: {
    confirmaStergere: t('corpuri.confirmaStergere'),
    eroareStergere: t('corpuri.eroareStergere')
  }
}) %></script>
<script src="/static/corps-list.js?v=<%= assetV %>"></script>
