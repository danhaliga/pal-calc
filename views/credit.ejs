<div class="top">
  <h1><%= t('credit.titlu') %></h1>
  <a class="btn" href="/orders"><%= t('credit.comenzileMele') %></a>
</div>

<% if (alimentat) { %>
  <div class="warn ok"><%= t('credit.alimentat') %></div>
<% } %>
<% if (insuficient) { %>
  <div class="warn err"><%= t('credit.insuficient', { pret: (pretCorp / 100).toFixed(2) }) %></div>
<% } %>

<div class="credit-grid">
  <div class="panel sold-card">
    <div class="l"><%= t('credit.soldDisponibil') %></div>
    <div class="v"><%= (sold / 100).toFixed(2) %> <span><%= t('comun.lei') %></span></div>
    <div class="muted small">
      <%- t('credit.unCorpCosta', { pret: (pretCorp / 100).toFixed(2), n: Math.floor(sold / pretCorp) }) %>
    </div>
  </div>

  <div class="panel">
    <h2><%= t('credit.alimenteaza') %></h2>
    <p class="hint"><%= t('credit.explicatie') %></p>
    <div class="pachete">
      <% pachete.forEach(function (p) { %>
        <form method="post" action="/credit/topup" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="amount_cents" value="<%= p %>">
          <button class="btn pachet" type="submit">
            <b><%= (p / 100).toFixed(0) %> <%= t('comun.lei') %></b>
            <span><%= t('credit.pachetCorpuri', { n: Math.floor(p / pretCorp) }) %></span>
          </button>
        </form>
      <% }); %>
    </div>
    <p class="hint" style="margin-top:12px">
      <%- paymentDriver === 'fake' ? t('credit.driverFake') : t('credit.driverStripe') %>
    </p>
  </div>
</div>

<div class="panel">
  <h2><%= t('credit.miscari') %></h2>
  <div class="tbl"><table>
    <thead><tr>
      <th><%= t('credit.data') %></th>
      <th><%= t('credit.operatiune') %></th>
      <th class="num"><%= t('credit.suma') %></th>
      <th class="num"><%= t('credit.soldDupa') %></th>
      <th><%= t('credit.detalii') %></th>
    </tr></thead>
    <tbody>
      <% if (!istoric.length) { %>
        <tr><td colspan="5" class="muted"><%= t('credit.niciunaInca') %></td></tr>
      <% } %>
      <% istoric.forEach(function (m) { %>
        <tr>
          <td class="muted"><%= m.created_at.slice(0, 16) %></td>
          <td><%= m.kind === 'topup' ? t('credit.opAlimentare') : m.kind === 'corp' ? t('credit.opCorpNou') : m.kind %></td>
          <td class="num <%= m.delta_cents > 0 ? 'plus' : 'minus' %>">
            <%= (m.delta_cents > 0 ? '+' : '') + (m.delta_cents / 100).toFixed(2) %>
          </td>
          <td class="num"><%= (m.balance_after / 100).toFixed(2) %></td>
          <td class="muted small">
            <%= m.note || '' %><%= m.kind === 'corp' && m.ref ? ' ' + t('credit.refCorp', { id: m.ref }) : '' %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table></div>
</div>
