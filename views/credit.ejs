<div class="top">
  <h1><%= t('credit.titlu') %></h1>
  <a class="btn" href="/orders"><%= t('credit.comenzileMele') %></a>
</div>

<% if (alimentat) { %>
  <div class="warn ok"><%= t('credit.alimentat') %></div>
<% } %>
<% if (insuficient) { %>
  <div class="warn err"><%= t('credit.insuficient', { pret: (pretCorp / 100).toFixed(2) }) %></div>
<% } %>

<div class="credit-grid">
  <div class="panel sold-card">
    <div class="l"><%= t('credit.soldDisponibil') %></div>
    <div class="v"><%= (sold / 100).toFixed(2) %> <span><%= t('comun.lei') %></span></div>
    <div class="muted small">
      <%- t('credit.unCorpCosta', { pret: (pretCorp / 100).toFixed(2), n: Math.floor(sold / pretCorp) }) %>
    </div>
  </div>

  <div class="panel">
    <h2><%= t('credit.alimenteaza') %></h2>
    <p class="hint"><%= t('credit.explicatie') %></p>
    <% if (!plataPornita) { %>
      <div class="warn"><%= t('credit.plataNepornita') %></div>
    <% } else { %>
    <% if (cereFacturare && lipsaFacturare.length) { %>
      <div class="warn"><a href="#facturare"><%= t('factura.inainteDePlata') %></a></div>
    <% } %>
    <div class="pachete">
      <% pachete.forEach(function (p) { %>
        <form method="post" action="/credit/topup" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="amount_cents" value="<%= p %>">
          <button class="btn pachet" type="submit">
            <b><%= (p / 100).toFixed(0) %> <%= t('comun.lei') %></b>
            <span><%= t('credit.pachetCorpuri', { n: Math.floor(p / pretCorp) }) %></span>
          </button>
        </form>
      <% }); %>
    </div>
    <p class="hint" style="margin-top:12px">
      <%- paymentDriver === 'fake' ? t('credit.driverFake') : t('credit.driverStripe') %>
    </p>
    <% } %>
  </div>
</div>

<%# Datele de facturare: cu bani adevarati nu se alimenteaza fara ele —
    din ele face Dan factura in programul lui de facturare (si in SPV). %>
<div class="panel" id="facturare">
  <h2><%= t('factura.dateTitlu') %></h2>
  <p class="hint"><%= t('factura.dateIntro') %></p>
  <% if (facturareSalvata && !lipsaFacturare.length) { %><div class="warn ok"><%= t('factura.dateSalvate') %></div><% } %>
  <% if (cereFacturare && lipsaFacturare.length) { %>
    <div class="warn err"><%= t('factura.dateLipsa', { campuri: lipsaFacturare.map(function (k) { return t('factura.camp.' + k); }).join(', ') }) %></div>
  <% } %>
  <form method="post" action="/credit/facturare">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <p>
      <label class="inline"><input type="radio" name="tip_facturare" value="pf" <%= facturare.tip === 'pf' ? 'checked' : '' %>> <%= t('factura.tipPf') %></label>
      &nbsp;&nbsp;
      <label class="inline"><input type="radio" name="tip_facturare" value="pj" <%= facturare.tip === 'pj' ? 'checked' : '' %>> <%= t('factura.tipPj') %></label>
    </p>
    <div class="f">
      <label><%= t('factura.camp.nume') %><input name="name" maxlength="80" value="<%= facturare.nume %>" autocomplete="name"></label>
      <label><%= t('factura.camp.firma') %><input name="firma" maxlength="120" value="<%= facturare.firma %>" autocomplete="organization"></label>
      <label><%= t('factura.camp.cui') %><input name="cui" maxlength="40" value="<%= facturare.cui %>"></label>
      <label><%= t('factura.camp.regCom') %><input name="reg_com" maxlength="40" value="<%= facturare.regCom %>"></label>
      <label class="full"><%= t('factura.camp.adresa') %><input name="adresa" maxlength="200" value="<%= facturare.adresa %>" autocomplete="street-address"></label>
      <label><%= t('factura.camp.oras') %><input name="oras" maxlength="80" value="<%= facturare.oras %>" autocomplete="address-level2"></label>
      <label><%= t('factura.camp.judet') %><input name="judet" maxlength="60" value="<%= facturare.judet %>" autocomplete="address-level1"></label>
      <label><%= t('factura.camp.telefon') %><input name="telefon" maxlength="40" value="<%= facturare.telefon %>" autocomplete="tel"></label>
    </div>
    <p class="legend"><%= t('factura.dateNota', { email: facturare.email }) %></p>
    <button class="btn primary" type="submit"><%= t('factura.dateSalveaza') %></button>
  </form>
</div>

<div class="panel">
  <h2><%= t('credit.miscari') %></h2>
  <div class="tbl"><table>
    <thead><tr>
      <th><%= t('credit.data') %></th>
      <th><%= t('credit.operatiune') %></th>
      <th class="num"><%= t('credit.suma') %></th>
      <th class="num"><%= t('credit.soldDupa') %></th>
      <th><%= t('credit.detalii') %></th>
    </tr></thead>
    <tbody>
      <% if (!istoric.length) { %>
        <tr><td colspan="5" class="muted"><%= t('credit.niciunaInca') %></td></tr>
      <% } %>
      <% istoric.forEach(function (m) { %>
        <tr>
          <td class="muted"><%= m.created_at.slice(0, 16) %></td>
          <td><%= m.kind === 'topup' ? t('credit.opAlimentare') : m.kind === 'corp' ? t('credit.opCorpNou') : m.kind %></td>
          <td class="num <%= m.delta_cents > 0 ? 'plus' : 'minus' %>">
            <%= (m.delta_cents > 0 ? '+' : '') + (m.delta_cents / 100).toFixed(2) %>
          </td>
          <td class="num"><%= (m.balance_after / 100).toFixed(2) %></td>
          <td class="muted small">
            <%
              var nota = m.note || '';
              if (nota.indexOf('corp.') === 0) {
                var parti = nota.split('|');
                nota = t(parti[0], parti[1] ? { nume: parti[1] } : null);
              }
            %><%= nota %><%= m.kind === 'corp' && m.ref ? ' ' + t('credit.refCorp', { id: m.ref }) : '' %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table></div>
</div>
