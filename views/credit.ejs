<div class="top">
  <h1>Creditul meu</h1>
  <a class="btn" href="/orders">Comenzile mele</a>
</div>

<% if (alimentat) { %>
  <div class="warn ok">Creditul a fost alimentat.</div>
<% } %>
<% if (insuficient) { %>
  <div class="warn err">
    Nu ai destul credit pentru un corp nou (<%= (pretCorp / 100).toFixed(2) %> lei).
    Alimentează mai jos și reia.
  </div>
<% } %>

<div class="credit-grid">
  <div class="panel sold-card">
    <div class="l">Sold disponibil</div>
    <div class="v"><%= (sold / 100).toFixed(2) %> <span>lei</span></div>
    <div class="muted small">
      Un corp costă <b><%= (pretCorp / 100).toFixed(2) %> lei</b> —
      îți ajunge pentru <b><%= Math.floor(sold / pretCorp) %></b> corpuri.
    </div>
  </div>

  <div class="panel">
    <h2>Alimentează</h2>
    <p class="hint">
      Plătești o dată, apoi adaugi corpuri din credit. Suma se scade în momentul în care
      adaugi un corp într-o comandă.
    </p>
    <div class="pachete">
      <% pachete.forEach(function (p) { %>
        <form method="post" action="/credit/topup" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="amount_cents" value="<%= p %>">
          <button class="btn pachet" type="submit">
            <b><%= (p / 100).toFixed(0) %> lei</b>
            <span><%= Math.floor(p / pretCorp) %> corpuri</span>
          </button>
        </form>
      <% }); %>
    </div>
    <p class="hint" style="margin-top:12px">
      <% if (paymentDriver === 'fake') { %>
        Driverul de plată este <code>fake</code>: creditul se adaugă imediat, fără card.
      <% } else { %>
        Vei fi dus la Stripe Checkout. Creditul se adaugă doar după confirmarea plății.
      <% } %>
    </p>
  </div>
</div>

<div class="panel">
  <h2>Mișcările din cont</h2>
  <div class="tbl"><table>
    <thead><tr>
      <th>Data</th><th>Operațiune</th><th class="num">Sumă</th><th class="num">Sold după</th><th>Detalii</th>
    </tr></thead>
    <tbody>
      <% if (!istoric.length) { %>
        <tr><td colspan="5" class="muted">Nicio mișcare încă.</td></tr>
      <% } %>
      <% istoric.forEach(function (t) { %>
        <tr>
          <td class="muted"><%= t.created_at.slice(0, 16) %></td>
          <td><%= t.kind === 'topup' ? 'Alimentare' : t.kind === 'corp' ? 'Corp nou' : t.kind %></td>
          <td class="num <%= t.delta_cents > 0 ? 'plus' : 'minus' %>">
            <%= (t.delta_cents > 0 ? '+' : '') + (t.delta_cents / 100).toFixed(2) %>
          </td>
          <td class="num"><%= (t.balance_after / 100).toFixed(2) %></td>
          <td class="muted small">
            <%= t.note || '' %><%= t.kind === 'corp' && t.ref ? ' (corp #' + t.ref + ')' : '' %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table></div>
</div>
