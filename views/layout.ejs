<!doctype html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title><%= typeof title !== 'undefined' && title ? title + ' · ' + appName : appName %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="/static/styles.css?v=<%= assetV %>">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='13' font-size='13'>&#128208;</text></svg>">
<script src="/shared/i18n.js?v=<%= assetV %>"></script>
<script src="/static/i18n-pagina.js?v=<%= assetV %>"></script>
</head>
<body>

<header class="site">
  <div class="wrap site-inner">
    <a class="logo" href="<%= user ? '/corps' : '/' %>">
      <span class="logo-mark">▤</span>
      <span>
        <b><%= t('app.nume') %></b>
        <small><%= t('app.domeniu') %></small>
      </span>
    </a>
    <nav>
      <% if (user) { %>
        <a href="/orders" class="<%= currentPath.startsWith('/orders') ? 'on' : '' %>"><%= t('nav.comenzi') %></a>
        <a href="/corps" class="<%= currentPath.startsWith('/corps') ? 'on' : '' %>"><%= t('nav.corpuri') %></a>
        <a href="/ghid" class="<%= currentPath.startsWith('/ghid') ? 'on' : '' %>"><%= t('articole.titlu') %></a>
        <a href="/credit" class="credit-link <%= currentPath === '/credit' ? 'on' : '' %>">
          <%= t('nav.credit') %>: <b><%= soldLei %> <%= t('comun.lei') %></b>
        </a>
        <% if (user.is_admin) { %><a href="/admin" class="<%= currentPath === '/admin' ? 'on' : '' %>"><%= t('nav.administrare') %></a><% } %>
        <a href="/cont" class="who <%= currentPath === '/cont' ? 'on' : '' %>"
           title="<%= t('nav.cont') %>"><%= user.name || user.email %></a>
        <%- include('partials/limba') %>
        <form method="post" action="/logout" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="link"><%= t('nav.iesi') %></button>
        </form>
      <% } else { %>
        <a href="/ghid" class="<%= currentPath.startsWith('/ghid') ? 'on' : '' %>"><%= t('articole.titlu') %></a>
        <%- include('partials/limba') %>
        <a href="/login"><%= t('nav.autentificare') %></a>
        <a href="/register" class="btn small primary"><%= t('nav.contNou') %></a>
      <% } %>
    </nav>
  </div>
</header>

<% if (paymentDriver === 'fake') { %>
  <div class="devbar"><%= t('app.platatest', { driver: 'fake' }) %></div>
<% } %>

<main class="wrap">
<%- body %>
</main>

<footer class="site-foot">
  <div class="wrap">
    <%= t('app.subsol') %>
    <%# Datele firmei si legaturile legale: obligatorii la vanzarea online
        in Romania (identificarea comerciantului, termeni, GDPR, ANPC-SAL). %>
    <% if (typeof firma !== 'undefined' && firma) { %>
    <div class="subsol-legal">
      <span><%= firma.denumire %> · CUI <%= firma.cui %> · <%= firma.regCom %> · <%= firma.sediu %></span>
      <nav>
        <a href="/termeni"><%= t('legal.termeni') %></a>
        <a href="/confidentialitate"><%= t('legal.confidentialitate') %></a>
        <a href="/cookies"><%= t('legal.cookies') %></a>
        <a href="https://anpc.ro/ce-este-sal/" target="_blank" rel="noopener"><%= t('legal.anpcSal') %></a>
        <a href="https://anpc.ro" target="_blank" rel="noopener">ANPC</a>
      </nav>
    </div>
    <% } %>
  </div>
</footer>

<%# Fereastra de confirmare. Sta in layout, nu in scripturi, ca sa fie scrisa
    de server in limba paginii — altfel butoanele ei ar trebui traduse in
    browser, iar cataloagele de traduceri se pun doar pe paginile care le cer.

    Inlocuieste `window.confirm`, care e o fereastra a BROWSERULUI si pe care
    browserul are voie s-o opreasca — si o opreste, in panourile din
    aplicatii si in webview-uri. Cand o opreste, `confirm()` intoarce false
    fara sa intrebe, iar butonul de stergere nu face nimic, tacut. %>
<dialog id="intreaba" class="intreaba">
  <p data-intrebare></p>
  <div class="btns">
    <button type="button" class="btn danger" data-da><%= t('comun.sterge') %></button>
    <button type="button" class="btn" data-nu><%= t('comun.anuleaza') %></button>
  </div>
</dialog>

<script src="/static/interactiuni.js?v=<%= assetV %>"></script>
</body>
</html>
