<div class="top">
  <h1><%= t('admin.titlu') %></h1>
  <div class="btns" style="margin:0">
    <a class="btn primary" href="/admin/jurnal"><%= t('admin.jurnalLegatura') %></a>
    <a class="btn" href="/admin/articole"><%= t('articole.administrare') %></a>
    <a class="btn" href="/admin/limbi"><%= t('admin.traduceri') %></a>
  </div>
</div>

<div class="kpis">
  <div class="kpi"><div class="v"><%= users.length %></div><div class="l"><%= t('admin.kpiUtilizatori') %></div></div>
  <div class="kpi"><div class="v"><%= corps.length %></div><div class="l"><%= t('admin.kpiCorpuri') %></div></div>
  <div class="kpi"><div class="v"><%= totalCount %></div><div class="l"><%= t('admin.kpiPlati') %></div></div>
  <div class="kpi"><div class="v"><%= totalLei %> <%= t('comun.lei') %></div><div class="l"><%= t('admin.kpiIncasat') %></div></div>
</div>

<%# Cine foloseste aplicatia si de unde. E singura prospectie de piata pe
    care n-o citesti pe internet: se strange singura, din conturi. %>
<% if (tari.length || profile.length) { %>
  <div class="doua-coloane">
    <div class="panel">
      <h2><%= t('admin.dupaTara') %></h2>
      <% if (!tari.length) { %>
        <p class="muted"><%= t('admin.nimeniNuAZis') %></p>
      <% } else { %>
        <div class="tbl"><table>
          <thead><tr><th><%= t('cont.tara') %></th><th><%= t('cont.unitate') %></th>
            <th class="num"><%= t('admin.kpiUtilizatori') %></th></tr></thead>
          <tbody>
            <% tari.forEach(function (r) { %>
              <tr>
                <td><%= numeTara(r.tara) %></td>
                <td class="muted small"><%= t('unitate.' + unitatePentru(r.tara)) %></td>
                <td class="num"><%= r.n %></td>
              </tr>
            <% }); %>
          </tbody>
        </table></div>
      <% } %>
    </div>
    <div class="panel">
      <h2><%= t('admin.dupaProfil') %></h2>
      <% if (!profile.length) { %>
        <p class="muted"><%= t('admin.nimeniNuAZis') %></p>
      <% } else { %>
        <div class="tbl"><table>
          <thead><tr><th><%= t('cont.profil') %></th>
            <th class="num"><%= t('admin.kpiUtilizatori') %></th></tr></thead>
          <tbody>
            <% profile.forEach(function (r) { %>
              <tr><td><%= t('profil.' + r.profil) %></td><td class="num"><%= r.n %></td></tr>
            <% }); %>
          </tbody>
        </table></div>
      <% } %>
    </div>
  </div>
<% } %>

<%# Mesajele de la oameni stau primele: alea cer un răspuns, restul sunt cifre. %>
<div class="panel">
  <h2><%= t('admin.mesaje', { n: mesajeNoi }) %></h2>
  <% if (!mesaje.length) { %>
    <p class="muted"><%= t('admin.faraMesaje') %></p>
  <% } else { %>
    <div class="tbl"><table>
      <thead><tr><th><%= t('admin.cand') %></th><th><%= t('admin.email') %></th>
        <th><%= t('admin.dePeUnde') %></th><th><%= t('admin.mesajText') %></th></tr></thead>
      <tbody>
        <% mesaje.forEach(function (m) { %>
          <tr>
            <td class="muted small"><%= m.created_at.slice(0, 16) %></td>
            <td class="small"><%= m.email %></td>
            <td class="muted small"><%= m.pagina || '–' %></td>
            <td><%= m.text %></td>
          </tr>
        <% }); %>
      </tbody>
    </table></div>
  <% } %>
</div>

<div class="panel">
  <h2><%= t('admin.utilizatori') %></h2>
  <div class="tbl"><table>
    <thead><tr><th class="num">#</th><th><%= t('admin.email') %></th><th><%= t('admin.nume') %></th>
      <th class="num"><%= t('admin.creditColoana') %></th>
      <th class="num"><%= t('admin.comenzi') %></th><th class="num"><%= t('admin.corpuri') %></th>
      <th><%= t('admin.creat') %></th><th><%= t('admin.rol') %></th></tr></thead>
    <tbody>
      <% users.forEach(function (u) { %>
        <tr>
          <td class="num"><%= u.id %></td>
          <td><%= u.email %></td>
          <td><%= u.name || '–' %></td>
          <td class="num"><b><%= (u.credit_cents / 100).toFixed(2) %></b> <%= t('comun.lei') %></td>
          <td class="num"><%= u.comenzi %></td>
          <td class="num"><%= u.corps %></td>
          <td class="muted"><%= u.created_at.slice(0, 16) %></td>
          <td><%= u.is_admin ? t('admin.rolAdmin') : t('admin.rolUtilizator') %></td>
        </tr>
      <% }); %>
    </tbody>
  </table></div>
</div>

<div class="panel">
  <h2><%= t('admin.corpuri') %></h2>
  <div class="tbl"><table>
    <thead><tr><th class="num">#</th><th><%= t('admin.denumire') %></th><th><%= t('admin.utilizator') %></th>
      <th><%= t('admin.status') %></th><th><%= t('admin.modificat') %></th></tr></thead>
    <tbody>
      <% corps.forEach(function (c) { %>
        <tr>
          <td class="num"><%= c.id %></td>
          <td><%= c.name %></td>
          <td><%= c.email %></td>
          <td><span class="chip <%= c.status === 'paid' ? 'paid' : 'draft' %>"><%= c.status === 'paid' ? t('admin.platit') : t('admin.draft') %></span></td>
          <td class="muted"><%= c.updated_at.slice(0, 16) %></td>
        </tr>
      <% }); %>
    </tbody>
  </table></div>
</div>

<div class="panel">
  <h2><%= t('admin.plati') %></h2>
  <div class="tbl"><table>
    <thead><tr><th class="num">#</th><th><%= t('admin.utilizator') %></th><th><%= t('admin.corp') %></th>
      <th><%= t('admin.driver') %></th><th class="num"><%= t('admin.suma') %></th>
      <th><%= t('admin.status') %></th><th><%= t('admin.referinta') %></th><th><%= t('admin.data') %></th></tr></thead>
    <tbody>
      <% if (!payments.length) { %><tr><td colspan="8" class="muted"><%= t('admin.niciPlata') %></td></tr><% } %>
      <% payments.forEach(function (p) { %>
        <tr>
          <td class="num"><%= p.id %></td>
          <td><%= p.email %></td>
          <td><%= p.corp_name || '–' %></td>
          <td><%= p.provider %></td>
          <td class="num"><%= (p.amount_cents / 100).toFixed(2) %> <%= p.currency.toUpperCase() %></td>
          <td><%= p.status %></td>
          <td class="muted small"><%= p.provider_ref || '–' %></td>
          <td class="muted"><%= p.created_at.slice(0, 16) %></td>
        </tr>
      <% }); %>
    </tbody>
  </table></div>
</div>
