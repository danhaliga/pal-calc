<div class="top">
  <h1><%= t('admin.titlu') %></h1>
  <a class="btn" href="/admin/limbi"><%= t('admin.traduceri') %></a>
</div>

<div class="kpis">
  <div class="kpi"><div class="v"><%= users.length %></div><div class="l"><%= t('admin.kpiUtilizatori') %></div></div>
  <div class="kpi"><div class="v"><%= corps.length %></div><div class="l"><%= t('admin.kpiCorpuri') %></div></div>
  <div class="kpi"><div class="v"><%= totalCount %></div><div class="l"><%= t('admin.kpiPlati') %></div></div>
  <div class="kpi"><div class="v"><%= totalLei %> <%= t('comun.lei') %></div><div class="l"><%= t('admin.kpiIncasat') %></div></div>
</div>

<div class="panel">
  <h2><%= t('admin.utilizatori') %></h2>
  <div class="tbl"><table>
    <thead><tr><th class="num">#</th><th><%= t('admin.email') %></th><th><%= t('admin.nume') %></th>
      <th class="num"><%= t('admin.creditColoana') %></th>
      <th class="num"><%= t('admin.comenzi') %></th><th class="num"><%= t('admin.corpuri') %></th>
      <th><%= t('admin.creat') %></th><th><%= t('admin.rol') %></th></tr></thead>
    <tbody>
      <% users.forEach(function (u) { %>
        <tr>
          <td class="num"><%= u.id %></td>
          <td><%= u.email %></td>
          <td><%= u.name || '–' %></td>
          <td class="num"><b><%= (u.credit_cents / 100).toFixed(2) %></b> <%= t('comun.lei') %></td>
          <td class="num"><%= u.comenzi %></td>
          <td class="num"><%= u.corps %></td>
          <td class="muted"><%= u.created_at.slice(0, 16) %></td>
          <td><%= u.is_admin ? t('admin.rolAdmin') : t('admin.rolUtilizator') %></td>
        </tr>
      <% }); %>
    </tbody>
  </table></div>
</div>

<div class="panel">
  <h2><%= t('admin.corpuri') %></h2>
  <div class="tbl"><table>
    <thead><tr><th class="num">#</th><th><%= t('admin.denumire') %></th><th><%= t('admin.utilizator') %></th>
      <th><%= t('admin.status') %></th><th><%= t('admin.modificat') %></th></tr></thead>
    <tbody>
      <% corps.forEach(function (c) { %>
        <tr>
          <td class="num"><%= c.id %></td>
          <td><%= c.name %></td>
          <td><%= c.email %></td>
          <td><span class="chip <%= c.status === 'paid' ? 'paid' : 'draft' %>"><%= c.status === 'paid' ? t('admin.platit') : t('admin.draft') %></span></td>
          <td class="muted"><%= c.updated_at.slice(0, 16) %></td>
        </tr>
      <% }); %>
    </tbody>
  </table></div>
</div>

<div class="panel">
  <h2><%= t('admin.plati') %></h2>
  <div class="tbl"><table>
    <thead><tr><th class="num">#</th><th><%= t('admin.utilizator') %></th><th><%= t('admin.corp') %></th>
      <th><%= t('admin.driver') %></th><th class="num"><%= t('admin.suma') %></th>
      <th><%= t('admin.status') %></th><th><%= t('admin.referinta') %></th><th><%= t('admin.data') %></th></tr></thead>
    <tbody>
      <% if (!payments.length) { %><tr><td colspan="8" class="muted"><%= t('admin.niciPlata') %></td></tr><% } %>
      <% payments.forEach(function (p) { %>
        <tr>
          <td class="num"><%= p.id %></td>
          <td><%= p.email %></td>
          <td><%= p.corp_name || '–' %></td>
          <td><%= p.provider %></td>
          <td class="num"><%= (p.amount_cents / 100).toFixed(2) %> <%= p.currency.toUpperCase() %></td>
          <td><%= p.status %></td>
          <td class="muted small"><%= p.provider_ref || '–' %></td>
          <td class="muted"><%= p.created_at.slice(0, 16) %></td>
        </tr>
      <% }); %>
    </tbody>
  </table></div>
</div>
