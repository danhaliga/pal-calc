<div class="auth">
  <div class="panel">
    <h1>Autentificare</h1>
    <% if (error) { %><div class="warn err"><%= error %></div><% } %>
    <form method="post" action="/login" autocomplete="on">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Email
        <input type="email" name="email" required autofocus autocomplete="email"
               value="<%= values.email || '' %>">
      </label>
      <label>Parolă
        <input type="password" name="password" required autocomplete="current-password">
      </label>
      <button class="btn primary full" type="submit">Intră în cont</button>
    </form>
    <p class="muted">Nu ai cont? <a href="/register">Creează unul</a>.</p>
  </div>
</div>
