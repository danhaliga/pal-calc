<div class="auth">
  <div class="panel">
    <h1><%= t('auth.autentificare') %></h1>
    <% if (error) { %><div class="warn err"><%= error %></div><% } %>
    <form method="post" action="/login" autocomplete="on">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label><%= t('auth.emailSauUtilizator') %>
        <input type="text" name="email" required autofocus autocomplete="username"
               value="<%= values.email || '' %>">
      </label>
      <label><%= t('auth.parola') %>
        <input type="password" name="password" required autocomplete="current-password">
      </label>
      <button class="btn primary full" type="submit"><%= t('auth.intraInCont') %></button>
    </form>
    <p class="muted"><%= t('auth.nuAiCont') %> <a href="/register"><%= t('auth.creeazaUnul') %></a>.</p>
  </div>
</div>
