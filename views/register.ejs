<div class="auth">
  <div class="panel">
    <h1><%= t('auth.contNou') %></h1>
    <% if (error) { %><div class="warn err"><%= error %></div><% } %>
    <form method="post" action="/register" autocomplete="on">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label><%= t('auth.numeOptional') %>
        <input type="text" name="name" maxlength="80" autocomplete="name" value="<%= values.name || '' %>">
      </label>
      <label><%= t('auth.email') %>
        <input type="email" name="email" required autocomplete="email" value="<%= values.email || '' %>">
      </label>
      <%# Tara vine deja completata din antetul browserului. E aici, si nu pe
          pagina contului, fiindca de ea atarna unitatea de masura: un atelier
          american care deseneaza primul corp in milimetri se uita la
          aplicatie ca la una strina. %>
      <label><%= t('auth.tara') %> <span class="muted"><%= t('auth.taraNota') %></span>
        <select name="tara" autocomplete="country">
          <option value=""><%= t('cont.taraNealeasa') %></option>
          <% tari.forEach(function (x) { %>
            <option value="<%= x.cod %>" <%= taraAleasa === x.cod ? 'selected' : '' %>><%= x.nume %></option>
          <% }); %>
        </select>
      </label>
      <label><%= t('auth.parola') %> <span class="muted"><%= t('auth.minimCaractere', { n: 8 }) %></span>
        <input type="password" name="password" required minlength="8" autocomplete="new-password">
      </label>
      <label><%= t('auth.repetaParola') %>
        <input type="password" name="password2" required minlength="8" autocomplete="new-password">
      </label>
      <button class="btn primary full" type="submit"><%= t('auth.creeazaContul') %></button>
      <p class="legend"><%= t('legal.acordCont') %>
    <a href="/termeni" target="_blank"><%= t('legal.termeni') %></a> ·
    <a href="/confidentialitate" target="_blank"><%= t('legal.confidentialitate') %></a></p>
</form>
    <p class="muted"><%= t('auth.aiDejaCont') %> <a href="/login"><%= t('auth.autentificaTe') %></a>.</p>
  </div>
</div>
