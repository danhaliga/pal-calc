<div class="top">
  <div>
    <h1><%= t('cont.titlu') %></h1>
    <p class="muted"><%= t('cont.intro') %></p>
  </div>
  <a class="btn" href="/orders"><%= t('comun.inapoiLa') %></a>
</div>

<% if (eroare) { %><div class="warn err"><%= eroare %></div><% } %>
<% if (salvat) { %><div class="warn ok"><%= t('cont.salvat') %></div><% } %>

<div class="panel" style="max-width:820px">
  <form method="post" action="/cont" autocomplete="on">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <%# Tara si limba stau primele: alea schimba felul in care arata
        aplicatia. Restul sunt date care se scriu pe hartie. %>
    <fieldset>
      <legend><%= t('cont.legLocul') %></legend>
      <div class="f">
        <label><%= t('cont.tara') %>
          <select name="tara" id="tara">
            <option value=""><%= t('cont.taraNealeasa') %></option>
            <% tari.forEach(function (x) { %>
              <option value="<%= x.cod %>" <%= taraAleasa === x.cod ? 'selected' : '' %>><%= x.nume %></option>
            <% }); %>
          </select>
        </label>
        <label><%= t('cont.limba') %>
          <select name="lang">
            <option value=""><%= t('cont.limbaDinBrowser') %></option>
            <% limbi.forEach(function (l) { %>
              <option value="<%= l.cod %>" <%= valori.lang === l.cod ? 'selected' : '' %>><%= l.nume %></option>
            <% }); %>
          </select>
        </label>
        <label><%= t('cont.profil') %>
          <select name="profil">
            <option value=""><%= t('cont.profilNealeasa') %></option>
            <% profile.forEach(function (p) { %>
              <option value="<%= p %>" <%= valori.profil === p ? 'selected' : '' %>><%= t('profil.' + p) %></option>
            <% }); %>
          </select>
        </label>
      </div>
    </fieldset>

    <fieldset>
      <legend><%= t('cont.legCine') %></legend>
      <div class="f">
        <label><%= t('cont.nume') %>
          <input type="text" name="name" maxlength="<%= lungimi.name %>" autocomplete="name"
                 value="<%= valori.name %>">
        </label>
        <label><%= t('cont.firma') %>
          <input type="text" name="firma" maxlength="<%= lungimi.firma %>" autocomplete="organization"
                 placeholder="<%= t('cont.firmaExemplu') %>" value="<%= valori.firma %>">
        </label>
        <label><%= t('cont.cui') %>
          <input type="text" name="cui" maxlength="<%= lungimi.cui %>" value="<%= valori.cui %>">
        </label>
        <label><%= t('cont.telefon') %>
          <input type="tel" name="telefon" maxlength="<%= lungimi.telefon %>" autocomplete="tel"
                 placeholder="<%= t('comanda.telefonExemplu') %>" value="<%= valori.telefon %>">
        </label>
        <label><%= t('cont.oras') %>
          <input type="text" name="oras" maxlength="<%= lungimi.oras %>" autocomplete="address-level2"
                 value="<%= valori.oras %>">
        </label>
        <label><%= t('cont.site') %>
          <input type="text" name="site" maxlength="<%= lungimi.site %>" autocomplete="url"
                 placeholder="<%= t('cont.siteExemplu') %>" value="<%= valori.site %>">
        </label>
        <label class="full"><%= t('cont.adresa') %>
          <input type="text" name="adresa" maxlength="<%= lungimi.adresa %>" autocomplete="street-address"
                 value="<%= valori.adresa %>">
        </label>
      </div>
      <p class="legend"><%= t('cont.notaFoaie') %></p>
    </fieldset>

    <fieldset>
      <legend><%= t('cont.legIntrare') %></legend>
      <div class="f">
        <label><%= t('cont.email') %>
          <input type="email" value="<%= user.email %>" readonly disabled>
        </label>
        <label><%= t('cont.dinCand') %>
          <input type="text" value="<%= user.created_at ? user.created_at.slice(0, 10) : '' %>" readonly disabled>
        </label>
      </div>
      <p class="legend"><%= t('cont.notaEmail') %></p>
    </fieldset>

    <button class="btn primary" type="submit"><%= t('cont.salveaza') %></button>
  </form>
</div>

