# Copiaza acest fisier in .env si completeaza valorile.
#
# ATENTIE: valorile de mai jos sunt publicate in depozit, deci le stie
# oricine. Pe o adresa publica aplicatia REFUZA sa porneasca daca le gaseste
# nemodificate si iti spune care sunt. Vezi src/pornire.js.
#
# „Adresa publica" inseamna NODE_ENV=production sau un APP_URL care nu arata
# spre localhost. Pe calculatorul tau aceleasi verificari doar avertizeaza.

# Portul si adresa publica a aplicatiei
PORT=3000
APP_URL=http://localhost:3000

# Secretul sesiunii. Minimum 32 de caractere, lung si aleatoriu.
# Generare: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=schimba-ma-cu-un-secret-lung-si-aleatoriu

# Plata: 'fake' pentru dezvoltare locala, 'stripe' pentru Stripe Checkout
# Creditul se alimenteaza o data, apoi fiecare corp adaugat scade din sold.
PAYMENT_DRIVER=fake
PRICE_PER_CORP_CENTS=500
CURRENCY=ron

# Chei Stripe (necesare doar cand PAYMENT_DRIVER=stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Contul de administrator creat de `npm run seed`, cu credit de pornire.
# Parola de mai jos e publicata: schimb-o INAINTE sa urci aplicatia undeva.
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=admin1234
SEED_CREDIT_CENTS=10000
