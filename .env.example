# Copiaza acest fisier in .env si completeaza valorile.

# Portul si adresa publica a aplicatiei
PORT=3000
APP_URL=http://localhost:3000

# Secretul sesiunii (schimba-l cu un sir lung si aleatoriu)
SESSION_SECRET=schimba-ma-cu-un-secret-lung-si-aleatoriu

# Plata: 'fake' pentru dezvoltare locala, 'stripe' pentru Stripe Checkout
# Creditul se alimenteaza o data, apoi fiecare corp adaugat scade din sold.
PAYMENT_DRIVER=fake
PRICE_PER_CORP_CENTS=500
CURRENCY=ron

# Chei Stripe (necesare doar cand PAYMENT_DRIVER=stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Contul de administrator creat de `npm run seed`, cu credit de pornire
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=admin1234
SEED_CREDIT_CENTS=10000
